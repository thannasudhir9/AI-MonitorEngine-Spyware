{"step_index":59,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-07T06:00:20Z","input_tokens":2750,"cache_read_tokens":45341,"output_tokens":4447,"thinking":"The `backend/detector.py` module implements the Multi-Vector Detection Engine, performing a series of analysis passes on running processes. The first pass focuses on identifying potential masquerading or typosquatting, checking if critical system process names are running from unexpected locations. The hypothesis is to identify deviations from expected process locations as a potential threat indicator.\n\n\nPass one identifies masquerading and typosquatting threats; `TYPOSQUAT_PATTERNS` are checked to flag critical typosquatting malware. The second pass evaluates known threat, RMM, and RAT signatures by checking against specific databases. Following this, path and location heuristics are applied to assess executable paths for suspicious locations. Subsequently, command-line patterns are evaluated for potential abuse, like base64-encoded PowerShell or download cradles. Finally, parent-child process relationships are analyzed for anomalies, especially with Office apps and browsers spawning potentially malicious child processes.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\nAegisShield - Multi-Vector Threat Detection Engine\nCombines signature matching, LOLRMM tracking, masquerading detection,\ncommand-line heuristics, PE binary analysis, and network telemetry.\n\"\"\"\n\nimport os\nimport psutil\nfrom typing import Dict, List, Any, Optional\n\nfrom .config import (\n    CRITICAL_SYSTEM_PROCESSES, TYPOSQUAT_PATTERNS, SUSPICIOUS_PATHS,\n    SCORE_CRITICAL, SCORE_HIGH, SCORE_MEDIUM, SCORE_LOW\n)\nfrom .signatures_db import (\n    RMM_DATABASE, TROJAN_RAT_DATABASE, TUNNEL_DATABASE,\n    SUSPICIOUS_CMDLINE_PATTERNS, SUSPICIOUS_PARENT_CHILD\n)\nfrom .pe_analyzer import analyze_binary\nfrom .network_monitor import scan_network_connections, get_process_network_summary\n\n\nclass ThreatDetector:\n    \"\"\"Core Threat Detection and Risk Scoring Engine.\"\"\"\n\n    def __init__(self):\n        self._parent_cache: Dict[int, str] = {}\n\n    def scan_all_processes(self, detailed_pe: bool = False) -> List[Dict[str, Any]]:\n        \"\"\"\n        Enumerate and evaluate all running processes on the system.\n        Returns a list of analyzed process records with threat scoring.\n        \"\"\"\n        results = []\n        network_cache = scan_network_connections()\n\n        # Build parent cache first\n        self._parent_cache.clear()\n        for proc in psutil.process_iter([\"pid\", \"name\"]):\n            try:\n                self._parent_cache[proc.info[\"pid\"]] = (proc.info[\"name\"] or \"\").lower()\n            except (psutil.NoSuchProcess, psutil.AccessDenied):\n                continue\n\n        # Scan each process\n        for proc in psutil.process_iter([\"pid\", \"name\", \"exe\", \"cmdline\", \"ppid\", \"username\", \"cpu_percent\", \"memory_info\", \"create_time\"]):\n            try:\n                analyzed = self.evaluate_process(proc, network_cache=network_cache, detailed_pe=detailed_pe)\n                if analyzed:\n                    results.append(analyzed)\n            except (psutil.NoSuchProcess, psutil.AccessDenied):\n                continue\n            except Exception:\n                continue\n\n        # Sort: Highest threat score first, then by CPU%\n        results.sort(key=lambda x: (x[\"threat_score\"], x[\"cpu_percent\"]), reverse=True)\n        return results\n\n    def evaluate_process(\n        self,\n        proc: psutil.Process,\n        network_cache: Optional[Dict[int, List[Dict[str, Any]]]] = None,\n        detailed_pe: bool = False\n    ) -> Optional[Dict[str, Any]]:\n        \"\"\"\n        Evaluate a single process across all detection vectors.\n        \"\"\"\n        try:\n            pid = proc.pid\n            name = (proc.name() or \"\").strip()\n            lower_name = name.lower()\n            \n            # Executable path\n            try:\n                exe_path = proc.exe() or \"\"\n            except (psutil.AccessDenied, psutil.NoSuchProcess):\n                exe_path = \"\"\n            lower_exe = exe_path.lower()\n\n            # Command line\n            try:\n                cmdline_list = proc.cmdline() or []\n                cmdline = \" \".join(cmdline_list)\n            except (psutil.AccessDenied, psutil.NoSuchProcess):\n                cmdline = \"\"\n            lower_cmdline = cmdline.lower()\n\n            # Parent PID & Parent Name\n            try:\n                ppid = proc.ppid()\n                parent_name = self._parent_cache.get(ppid, \"\")\n            except (psutil.AccessDenied, psutil.NoSuchProcess):\n                ppid = 0\n                parent_name = \"\"\n\n            # User & Memory\n            try:\n                username = proc.username() or \"SYSTEM/Unknown\"\n            except (psutil.AccessDenied, psutil.NoSuchProcess):\n                username = \"Protected/Unknown\"\n\n            try:\n                mem_bytes = proc.memory_info().rss\n                memory_mb = round(mem_bytes / (1024 * 1024), 2)\n            except (psutil.AccessDenied, psutil.NoSuchProcess):\n                memory_mb = 0.0\n\n            try:\n                cpu_percent = proc.cpu_percent(interval=None)\n            except Exception:\n                cpu_percent = 0.0\n\n        except (psutil.NoSuchProcess, psutil.AccessDenied):\n            return None\n\n        # Tracking detection metrics\n        threat_score = 0\n        reasons: List[Dict[str, Any]] = []\n        categories = set()\n        matched_signatures = []\n\n        # ==============================================================\n        # PASS 1: Masquerading & Typosquatting Detection\n        # ==============================================================\n        if lower_name in CRITICAL_SYSTEM_PROCESSES:\n            sys_rule = CRITICAL_SYSTEM_PROCESSES[lower_name]\n            expected = sys_rule.get(\"expected_path\")\n            if expected and exe_path and not lower_exe.startswith(expected):\n                threat_score += 95\n                categories.add(\"Trojan / Masquerading\")\n                reasons.append({\n                    \"vector\": \"Masquerading System Process\",\n                    \"severity\": \"CRITICAL\",\n                    \"score\": 95,\n                    \"detail\": f\"Process '{name}' is mimicking a Windows system binary but running from illegitimate path: {exe_path}\"\n                })\n\n        for typo in TYPOSQUAT_PATTERNS:\n            if typo in lower_name and lower_name not in CRITICAL_SYSTEM_PROCESSES:\n                threat_score += 85\n                categories.add(\"Trojan / Typosquatting\")\n                reasons.append({\n                    \"vector\": \"Typosquatted Binary Name\",\n                    \"severity\": \"CRITICAL\",\n                    \"score\": 85,\n                    \"detail\": f\"Process name '{name}' appears to be spoofing a core system binary ({typo}).\"\n                })\n                break\n\n        # ==============================================================\n        # PASS 2: Known Threat / RAT / RMM / Tunnel Signatures\n        # ==============================================================\n        if lower_name in TROJAN_RAT_DATABASE:\n            threat_meta = TROJAN_RAT_DATABASE[lower_name]\n            threat_score += threat_meta[\"score\"]\n            categories.add(threat_meta[\"category\"])\n            matched_signatures.append(threat_meta[\"name\"])\n            reasons.append({\n                \"vector\": \"Known Malware Signature\",\n                \"severity\": threat_meta[\"severity\"],\n                \"score\": threat_meta[\"score\"],\n                \"detail\": f\"Matches verified malware threat signature: {threat_meta['name']}. {threat_meta['description']}\"\n            })\n\n        if lower_name in RMM_DATABASE:\n            rmm_meta = RMM_DATABASE[lower_name]\n            threat_score += rmm_meta[\"score\"]\n            categories.add(rmm_meta[\"category\"])\n            matched_signatures.append(rmm_meta[\"name\"])\n            reasons.append({\n                \"vector\": \"Remote Desktop / RMM Tool\",\n                \"severity\": rmm_meta[\"severity\"],\n                \"score\": rmm_meta[\"score\"],\n                \"detail\": f\"Active Remote Monitoring & Control software: {rmm_meta['name']}. {rmm_meta['description']}\"\n            })\n\n        if lower_name in TUNNEL_DATABASE:\n            tunnel_meta = TUNNEL_DATABASE[lower_name]\n            threat_score += tunnel_meta[\"score\"]\n            categories.add(tunnel_meta[\"category\"])\n            matched_signatures.append(tunnel_meta[\"name\"])\n            reasons.append({\n                \"vector\": \"Reverse Proxy / Ingress Tunnel\",\n                \"severity\": tunnel_meta[\"severity\"],\n                \"score\": tunnel_meta[\"score\"],\n                \"detail\": f\"Reverse ingress tunnel tool: {tunnel_meta['name']}. {tunnel_meta['description']}\"\n            })\n\n        # ==============================================================\n        # PASS 3: Suspicious Execution Paths Heuristics\n        # ==============================================================\n        if exe_path:\n            for susp_path in SUSPICIOUS_PATHS:\n                if susp_path in lower_exe:\n                    threat_score += 40\n                    categories.add(\"Suspicious Execution Path\")\n                    reasons.append({\n                        \"vector\": \"High-Risk Execution Directory\",\n                        \"severity\": \"HIGH\",\n                        \"score\": 40,\n                        \"detail\": f\"Process is executing from a known malware drop zone ({susp_path}).\"\n                    })\n                    break\n\n        # ==============================================================\n        # PASS 4: Command Line & LOLBin Abuse Heuristics\n        # ==============================================================\n        if lower_cmdline:\n            for cmd_rule in SUSPICIOUS_CMDLINE_PATTERNS:\n                if cmd_rule[\"pattern\"] in lower_cmdline:\n                    threat_score += cmd_rule[\"score\"]\n                    categories.add(cmd_rule[\"category\"])\n                    reasons.append({\n                        \"vector\": f\"Command-Line Anomaly: {cmd_rule['name']}\",\n                        \"severity\": cmd_rule[\"severity\"],\n                        \"score\": cmd_rule[\"score\"],\n                        \"detail\": cmd_rule[\"description\"]\n                    })\n\n        # ==============================================================\n        # PASS 5: Suspicious Parent-Child Process Relationship\n        # ==============================================================\n        if parent_name:\n            for tree_rule in SUSPICIOUS_PARENT_CHILD:\n                if parent_name in tree_rule[\"parent\"] and lower_name in tree_rule[\"children\"]:\n                    threat_score += tree_rule[\"score\"]\n                    categories.add(tree_rule[\"category\"])\n                    reasons.append({\n                        \"vector\": f\"Suspicious Process Ancestry: {tree_rule['name']}\",\n                        \"severity\": tree_rule[\"severity\"],\n                        \"score\": tree_rule[\"score\"],\n                        \"detail\": f\"Parent process '{parent_name}' spawned anomalous shell '{name}'.\"\n                    })\n\n        # ==============================================================\n        # PASS 6: Network Telemetry & Socket Inspection\n        # ==============================================================\n        network_summary = get_process_network_summary(pid, network_cache)\n        if network_summary[\"network_threat_score\"] > 0:\n            threat_score += network_summary[\"network_threat_score\"]\n            categories.add(\"Suspicious Network Activity\")\n            for flag in network_summary[\"network_flags\"]:\n                reasons.append({\n                    \"vector\": \"Network Telemetry Alert\",\n                    \"severity\": \"HIGH\",\n                    \"score\": 35,\n                    \"detail\": flag\n                })\n\n        # ==============================================================\n        # PASS 7: PE Binary Static Analysis (Entropy & APIs)\n        # ==============================================================\n        pe_meta = {}\n        if detailed_pe and exe_path and os.path.isfile(exe_path):\n            pe_meta = analyze_binary(exe_path)\n            if pe_meta.get(\"is_packed\"):\n                threat_score += 25\n                categories.add(\"Packed / Obfuscated Binary\")\n                reasons.append({\n                    \"vector\": \"High File Entropy (Packed)\",\n                    \"severity\": \"MEDIUM\",\n                    \"score\": 25,\n                    \"detail\": f\"Binary exhibits high Shannon entropy ({pe_meta.get('file_entropy')}), indicating crypter/packer evasion.\"\n                })\n\n            if pe_meta.get(\"api_score\", 0) > 0:\n                api_score = pe_meta[\"api_score\"]\n                threat_score += api_score\n                api_names = [a[\"api\"] for a in pe_meta.get(\"matched_apis\", [])]\n                reasons.append({\n                    \"vector\": \"Suspicious API Imports\",\n                    \"severity\": \"HIGH\" if api_score >= 30 else \"MEDIUM\",\n                    \"score\": api_score,\n                    \"detail\": f\"Binary imports dangerous APIs ({', '.join(api_names[:4])}).\"\n                })\n\n        # Normalize total Threat Score (0 - 100)\n        final_score = min(threat_score, 100)\n\n        # Determine Severity Level\n        if final_score >= SCORE_CRITICAL:\n            severity = \"CRITICAL\"\n        elif final_score >= SCORE_HIGH:\n            severity = \"HIGH\"\n        elif final_score >= SCORE_MEDIUM:\n            severity = \"MEDIUM\"\n        elif final_score >= SCORE_LOW:\n            severity = \"LOW\"\n        else:\n            severity = \"SAFE\"\n\n        # Determine Primary Category Label\n        if \"Trojan / RAT\" in categories or \"Trojan / Masquerading\" in categories or \"Trojan / Typosquatting\" in categories:\n            primary_cat = \"TROJAN\"\n        elif \"Spyware / Infostealer\" in categories:\n            primary_cat = \"SPYWARE\"\n        elif \"Remote Desktop / RMM\" in categories or \"Remote Desktop / VNC\" in categories:\n            primary_cat = \"REMOTE CONTROL\"\n        elif \"CryptoMiner\" in categories or \"CryptoMiner / Trojan\" in categories:\n            primary_cat = \"CRYPTOMINER\"\n        elif \"Reverse Tunnel / Proxy\" in categories:\n            primary_cat = \"REVERSE TUNNEL\"\n        elif final_score >= SCORE_MEDIUM:\n            primary_cat = \"SUSPICIOUS PROCESS\"\n        else:\n            primary_cat = \"NORMAL PROCESS\"\n\n        # Is process protected from termination?\n        is_protected = False\n        if lower_name in CRITICAL_SYSTEM_PROCESSES:\n            sys_info = CRITICAL_SYSTEM_PROCESSES[lower_name]\n            if not sys_info.get(\"allow_kill\", True):\n                # Only protected if running from expected legitimate system location\n                expected = sys_info.get(\"expected_path\")\n                if not expected or lower_exe.startswith(expected):\n                    is_protected = True\n\n        return {\n            \"pid\": pid,\n            \"name\": name,\n            \"exe\": exe_path,\n            \"cmdline\": cmdline,\n            \"ppid\": ppid,\n            \"parent_name\": parent_name,\n            \"username\": username,\n            \"memory_mb\": memory_mb,\n            \"cpu_percent\": cpu_percent,\n            \"threat_score\": final_score,\n            \"severity\": severity,\n            \"primary_category\": primary_cat,\n            \"categories\": list(categories),\n            \"matched_signatures\": matched_signatures,\n            \"reasons\": reasons,\n            \"is_threat\": final_score >= SCORE_MEDIUM,\n            \"is_protected\": is_protected,\n            \"network\": network_summary,\n            \"pe_info\": pe_meta\n        }\n","Overwrite":true,"Path":"c:\\Users\\thann\\Downloads\\AntiGravity\\SpywareProcessMon\\backend\\detector.py"}}]}
{"step_index":60,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:00:49Z","content":"Created At: 2026-11-07T07:00:49+01:00\nCompleted At: 2026-11-07T07:00:49+01:00\nCreated file."}
{"step_index":61,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-07T06:00:49Z","input_tokens":4501,"cache_read_tokens":48113,"output_tokens":3166,"thinking":"The `remediator.py` module will manage process termination, threat eradication, quarantining, and audit logging. The focus is to build the core functions, starting with process killing. There will be checks to avoid terminating critical system processes.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\nAegisShield - Remediation & Eradication Engine\nSafe process termination, recursive tree killing, threat quarantine,\nand immutable incident audit logging.\n\"\"\"\n\nimport os\nimport time\nimport json\nimport shutil\nimport psutil\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Dict, List, Any, Optional\n\nfrom .config import LOGS_DIR, QUARANTINE_DIR, CRITICAL_SYSTEM_PROCESSES, SCORE_MEDIUM\nfrom .pe_analyzer import get_file_hashes\n\nAUDIT_LOG_FILE = LOGS_DIR / \"audit_events.json\"\n\n\nclass ThreatRemediator:\n    \"\"\"Handles eradication of malicious processes, tree pruning, quarantine, and logs.\"\"\"\n\n    def __init__(self):\n        self._audit_log: List[Dict[str, Any]] = self._load_audit_log()\n\n    def _load_audit_log(self) -> List[Dict[str, Any]]:\n        \"\"\"Load persistent incident log from disk.\"\"\"\n        if AUDIT_LOG_FILE.exists():\n            try:\n                with open(AUDIT_LOG_FILE, \"r\", encoding=\"utf-8\") as f:\n                    return json.load(f)\n            except Exception:\n                return []\n        return []\n\n    def _save_audit_log(self):\n        \"\"\"Persist audit log to disk.\"\"\"\n        try:\n            with open(AUDIT_LOG_FILE, \"w\", encoding=\"utf-8\") as f:\n                json.dump(self._audit_log[-500:], f, indent=2)  # Retain latest 500 events\n        except Exception:\n            pass\n\n    def log_event(self, action: str, target: str, pid: Optional[int], details: str, status: str = \"SUCCESS\"):\n        \"\"\"Record an incident or remediation event.\"\"\"\n        event = {\n            \"id\": f\"evt_{int(time.time() * 1000)}\",\n            \"timestamp\": datetime.now().isoformat(),\n            \"time_display\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n            \"action\": action,\n            \"target\": target,\n            \"pid\": pid,\n            \"details\": details,\n            \"status\": status\n        }\n        self._audit_log.insert(0, event)\n        if len(self._audit_log) > 500:\n            self._audit_log = self._audit_log[:500]\n        self._save_audit_log()\n        return event\n\n    def get_audit_log(self, limit: int = 100) -> List[Dict[str, Any]]:\n        \"\"\"Retrieve recent audit events.\"\"\"\n        return self._audit_log[:limit]\n\n    def is_protected(self, proc: psutil.Process) -> bool:\n        \"\"\"Check if process is a protected Windows core binary.\"\"\"\n        try:\n            name = (proc.name() or \"\").lower()\n            if name in CRITICAL_SYSTEM_PROCESSES:\n                sys_rule = CRITICAL_SYSTEM_PROCESSES[name]\n                if not sys_rule.get(\"allow_kill\", True):\n                    # Check if running from legitimate System32\n                    expected = sys_rule.get(\"expected_path\")\n                    try:\n                        exe = (proc.exe() or \"\").lower()\n                        if not expected or exe.startswith(expected):\n                            return True\n                    except Exception:\n                        return True\n        except (psutil.NoSuchProcess, psutil.AccessDenied):\n            pass\n        return False\n\n    def kill_process(self, pid: int, force: bool = True, reason: str = \"Manual Eradication\") -> Dict[str, Any]:\n        \"\"\"\n        Safely terminate a single process by PID.\n        \"\"\"\n        try:\n            if not psutil.pid_exists(pid):\n                return {\"success\": False, \"message\": f\"Process PID {pid} does not exist or has already exited.\"}\n\n            proc = psutil.Process(pid)\n            name = proc.name()\n\n            # Safeguard core system processes\n            if self.is_protected(proc):\n                self.log_event(\"KILL_ABORTED\", name, pid, \"Protected core Windows OS process - Termination blocked\", \"BLOCKED\")\n                return {\n                    \"success\": False,\n                    \"message\": f\"Cannot terminate '{name}' (PID: {pid}). This is a protected Windows core system process.\"\n                }\n\n            # Attempt termination\n            proc.terminate()\n            try:\n                proc.wait(timeout=1.5)\n            except psutil.TimeoutExpired:\n                if force:\n                    proc.kill()\n                    proc.wait(timeout=1.5)\n\n            self.log_event(\"PROCESS_KILLED\", name, pid, f\"{reason}. Successfully terminated.\", \"SUCCESS\")\n            return {\n                \"success\": True,\n                \"message\": f\"Successfully terminated process '{name}' (PID: {pid}).\",\n                \"pid\": pid,\n                \"name\": name\n            }\n\n        except psutil.NoSuchProcess:\n            return {\"success\": True, \"message\": f\"Process PID {pid} already exited.\"}\n        except psutil.AccessDenied:\n            self.log_event(\"KILL_FAILED\", str(pid), pid, \"Access denied. Elevated administrator rights required.\", \"FAILED\")\n            return {\n                \"success\": False,\n                \"message\": f\"Access denied when killing PID {pid}. Please run AegisShield as Administrator.\"\n            }\n        except Exception as e:\n            self.log_event(\"KILL_ERROR\", str(pid), pid, str(e), \"ERROR\")\n            return {\"success\": False, \"message\": f\"Error terminating process: {str(e)}\"}\n\n    def kill_process_tree(self, pid: int, reason: str = \"Tree Eradication\") -> Dict[str, Any]:\n        \"\"\"\n        Recursively discover and terminate a parent process and all its children.\n        \"\"\"\n        try:\n            if not psutil.pid_exists(pid):\n                return {\"success\": False, \"message\": f\"Process PID {pid} does not exist.\"}\n\n            parent = psutil.Process(pid)\n            parent_name = parent.name()\n\n            if self.is_protected(parent):\n                return {\"success\": False, \"message\": f\"Process '{parent_name}' is a protected core system component.\"}\n\n            # Gather all children recursively\n            children = parent.children(recursive=True)\n            killed_list = []\n\n            # Kill children first\n            for child in children:\n                try:\n                    c_name = child.name()\n                    c_pid = child.pid\n                    if not self.is_protected(child):\n                        child.kill()\n                        killed_list.append(f\"{c_name} (PID: {c_pid})\")\n                except (psutil.NoSuchProcess, psutil.AccessDenied):\n                    continue\n\n            # Kill parent\n            parent.kill()\n            killed_list.append(f\"{parent_name} (PID: {pid})\")\n\n            details = f\"Terminated tree of {len(killed_list)} processes: {', '.join(killed_list)}\"\n            self.log_event(\"PROCESS_TREE_KILLED\", parent_name, pid, details, \"SUCCESS\")\n\n            return {\n                \"success\": True,\n                \"message\": f\"Successfully eradicated process tree ({len(killed_list)} processes killed).\",\n                \"killed_processes\": killed_list\n            }\n\n        except (psutil.NoSuchProcess, psutil.AccessDenied) as e:\n            return {\"success\": False, \"message\": f\"Failed to kill process tree: {str(e)}\"}\n\n    def kill_all_threats(self, detected_threats: List[Dict[str, Any]], min_score: int = SCORE_MEDIUM) -> Dict[str, Any]:\n        \"\"\"\n        Bulk eradicate all detected high-risk threats currently running.\n        Safely ignores protected processes.\n        \"\"\"\n        killed = []\n        errors = []\n\n        for threat in detected_threats:\n            if threat.get(\"threat_score\", 0) < min_score:\n                continue\n            if threat.get(\"is_protected\", False):\n                continue\n\n            pid = threat.get(\"pid\")\n            name = threat.get(\"name\", \"Unknown\")\n            cat = threat.get(\"primary_category\", \"THREAT\")\n\n            res = self.kill_process(pid, force=True, reason=f\"Bulk Eradication [{cat} - Score: {threat.get('threat_score')}]\")\n            if res.get(\"success\"):\n                killed.append({\"pid\": pid, \"name\": name, \"category\": cat})\n            else:\n                errors.append({\"pid\": pid, \"name\": name, \"error\": res.get(\"message\")})\n\n        self.log_event(\n            \"BULK_THREAT_KILL\",\n            f\"{len(killed)} Threats\",\n            None,\n            f\"Bulk eradication executed. Killed: {len(killed)}, Failed/Skipped: {len(errors)}\",\n            \"SUCCESS\" if killed else \"INFO\"\n        )\n\n        return {\n            \"success\": True,\n            \"killed_count\": len(killed),\n            \"killed\": killed,\n            \"failed_count\": len(errors),\n            \"errors\": errors,\n            \"message\": f\"Bulk eradication completed: {len(killed)} threats killed, {len(errors)} skipped.\"\n        }\n\n    def quarantine_file(self, file_path: str, reason: str = \"Suspicious Binary\") -> Dict[str, Any]:\n        \"\"\"\n        Isolate a suspicious executable into the quarantine repository.\n        Renames and revokes execute attributes.\n        \"\"\"\n        if not file_path or not os.path.exists(file_path):\n            return {\"success\": False, \"message\": \"File does not exist or invalid path.\"}\n\n        try:\n            src = Path(file_path)\n            hashes = get_file_hashes(file_path)\n            timestamp_str = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n            quarantine_filename = f\"{src.stem}_{timestamp_str}_{hashes['sha256'][:8]}.quarantined\"\n            dest = QUARANTINE_DIR / quarantine_filename\n\n            # Copy or move\n            shutil.copy2(src, dest)\n            try:\n                os.remove(src)\n                moved = True\n            except Exception:\n                moved = False\n\n            # Save quarantine receipt\n            meta = {\n                \"original_path\": file_path,\n                \"quarantine_path\": str(dest),\n                \"quarantined_at\": datetime.now().isoformat(),\n                \"hashes\": hashes,\n                \"reason\": reason,\n                \"original_removed\": moved\n            }\n            meta_file = dest.with_suffix(\".json\")\n            with open(meta_file, \"w\", encoding=\"utf-8\") as f:\n                json.dump(meta, f, indent=2)\n\n            self.log_event(\"FILE_QUARANTINED\", src.name, None, f\"Quarantined to {dest.name}. Removed source: {moved}\", \"SUCCESS\")\n\n            return {\n                \"success\": True,\n                \"message\": f\"File quarantined successfully to '{dest.name}'.\",\n                \"quarantine_name\": dest.name,\n                \"moved\": moved\n            }\n\n        except Exception as e:\n            self.log_event(\"QUARANTINE_FAILED\", file_path, None, str(e), \"ERROR\")\n            return {\"success\": False, \"message\": f\"Quarantine failed: {str(e)}\"}\n","Overwrite":true,"Path":"c:\\Users\\thann\\Downloads\\AntiGravity\\SpywareProcessMon\\backend\\remediator.py"}}]}
