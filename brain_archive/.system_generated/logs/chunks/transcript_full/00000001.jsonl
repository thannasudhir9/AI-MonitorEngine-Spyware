{"step_index":63,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-07T06:01:11Z","input_tokens":3230,"cache_read_tokens":52626,"output_tokens":1252,"thinking":"The threat simulation lab's value stems from its ability to test the application's detection capabilities even when no real malware is active. It provides a controlled environment to mimic suspicious activities, such as a process running from a temporary directory, enabling users to evaluate the system's response to potential threats. This is crucial for verifying that the antivirus solution effectively identifies and handles these simulated scenarios.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\nAegisShield - Harmless Threat Simulation Lab\nAllows users to safely launch benign test processes that exhibit detectable\nmalware, spyware, and RAT patterns (e.g., Temp execution, hidden window,\ndisguised process name) to verify detection and remediation in real time.\n\"\"\"\n\nimport os\nimport sys\nimport time\nimport subprocess\nfrom typing import Dict, List, Any\nfrom pathlib import Path\n\n# Track simulated test PIDs\n_SIMULATED_PIDS: List[int] = []\n\n\ndef spawn_simulated_threat(threat_type: str = \"temp_trojan\") -> Dict[str, Any]:\n    \"\"\"\n    Launch a completely harmless background Python process mimicking suspicious behavior.\n    \"\"\"\n    try:\n        if threat_type == \"temp_trojan\":\n            # Spawns harmless sleep in Temp folder with suspicious name\n            temp_dir = Path(os.environ.get(\"TEMP\", \".\"))\n            dummy_script = temp_dir / \"simulated_trojan_test.py\"\n            with open(dummy_script, \"w\", encoding=\"utf-8\") as f:\n                f.write(\"\"\"# AegisShield Safe Test Process\nimport time\nprint('Simulated Suspicious Process Active')\nwhile True:\n    time.sleep(1)\n\"\"\")\n            # Launch with hidden style or standard\n            proc = subprocess.Popen(\n                [sys.executable, str(dummy_script), \"--simulated-rat-beacon\"],\n                creationflags=subprocess.CREATE_NO_WINDOW if os.name == 'nt' else 0\n            )\n            _SIMULATED_PIDS.append(proc.pid)\n            return {\n                \"success\": True,\n                \"pid\": proc.pid,\n                \"type\": \"Temp Execution Trojan (Simulated)\",\n                \"details\": f\"Spawned simulated threat in {temp_dir} with PID {proc.pid}\"\n            }\n\n        elif threat_type == \"encoded_cmdline\":\n            # Spawns harmless process with simulated encoded/obfuscated command line\n            proc = subprocess.Popen(\n                [sys.executable, \"-c\", \"import time; time.sleep(300)\", \"-enc\", \"-w\", \"hidden\", \"downloadstring\"],\n                creationflags=subprocess.CREATE_NO_WINDOW if os.name == 'nt' else 0\n            )\n            _SIMULATED_PIDS.append(proc.pid)\n            return {\n                \"success\": True,\n                \"pid\": proc.pid,\n                \"type\": \"Obfuscated LOLBin Cradle (Simulated)\",\n                \"details\": f\"Spawned simulated encoded command process with PID {proc.pid}\"\n            }\n\n        elif threat_type == \"rmm_beacon\":\n            # Spawns harmless process listening or tagged as remote desktop beacon\n            proc = subprocess.Popen(\n                [sys.executable, \"-c\", \"import time; time.sleep(300)\", \"--remote-vnc-session\", \"--port-5900\"],\n                creationflags=subprocess.CREATE_NO_WINDOW if os.name == 'nt' else 0\n            )\n            _SIMULATED_PIDS.append(proc.pid)\n            return {\n                \"success\": True,\n                \"pid\": proc.pid,\n                \"type\": \"Remote Desktop / RMM Beacon (Simulated)\",\n                \"details\": f\"Spawned simulated remote control beacon with PID {proc.pid}\"\n            }\n\n        return {\"success\": False, \"message\": \"Unknown simulation type\"}\n\n    except Exception as e:\n        return {\"success\": False, \"message\": f\"Simulation failed: {str(e)}\"}\n\n\ndef stop_all_simulations() -> Dict[str, Any]:\n    \"\"\"Terminate any lingering simulated test processes.\"\"\"\n    killed = 0\n    import psutil\n    global _SIMULATED_PIDS\n    for pid in list(_SIMULATED_PIDS):\n        try:\n            if psutil.pid_exists(pid):\n                p = psutil.Process(pid)\n                p.kill()\n                killed += 1\n        except Exception:\n            pass\n    _SIMULATED_PIDS.clear()\n    return {\"success\": True, \"killed\": killed, \"message\": f\"Cleaned up {killed} test simulations.\"}\n","Overwrite":true,"Path":"c:\\Users\\thann\\Downloads\\AntiGravity\\SpywareProcessMon\\backend\\simulator.py"}}]}
{"step_index":64,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:01:22Z","content":"Created At: 2026-11-07T07:01:22+01:00\nCompleted At: 2026-11-07T07:01:22+01:00\nCreated file."}
{"step_index":65,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-07T06:01:22Z","input_tokens":3365,"cache_read_tokens":53819,"output_tokens":2862,"thinking":"FastAPI application needs creation with CORS middleware to serve the dashboard. Static files from the frontend directory will be mounted at the root to serve the Cyber SOC dashboard directly. API endpoints will provide system status information and scan capabilities.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\nAegisShield - FastAPI Server & Cyber SOC Dashboard Backend\nProvides RESTful APIs, WebSockets telemetry, and serves the frontend dashboard.\n\"\"\"\n\nimport os\nimport sys\nimport psutil\nimport asyncio\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Dict, List, Any, Optional\n\nfrom fastapi import FastAPI, WebSocket, WebSocketDisconnect, HTTPException\nfrom fastapi.middleware.cors import CORSMiddleware\nfrom fastapi.staticfiles import StaticFiles\nfrom fastapi.responses import FileResponse, JSONResponse\nfrom pydantic import BaseModel\n\nfrom .config import SERVER_HOST, SERVER_PORT, APP_ROOT, SCORE_MEDIUM\nfrom .detector import ThreatDetector\nfrom .remediator import ThreatRemediator\nfrom .persistence_hunter import get_all_persistence_entries, disable_persistence_item\nfrom .network_monitor import scan_network_connections\nfrom .simulator import spawn_simulated_threat, stop_all_simulations\n\napp = FastAPI(title=\"AegisShield Cyber Threat & Process Monitor\", version=\"2.0.0\")\n\n# Enable CORS for local access\napp.add_middleware(\n    CORSMiddleware,\n    allow_origins=[\"*\"],\n    allow_credentials=True,\n    allow_methods=[\"*\"],\n    allow_headers=[\"*\"],\n)\n\ndetector = ThreatDetector()\nremediator = ThreatRemediator()\n\nFRONTEND_DIR = APP_ROOT / \"frontend\"\n\n\n# Request Models\nclass KillRequest(BaseModel):\n    pid: int\n    force: bool = True\n    reason: Optional[str] = \"Manual Dashboard Eradication\"\n\n\nclass KillAllRequest(BaseModel):\n    min_score: int = SCORE_MEDIUM\n\n\nclass QuarantineRequest(BaseModel):\n    file_path: str\n    reason: Optional[str] = \"Suspicious Executable\"\n\n\nclass PersistenceDisableRequest(BaseModel):\n    id: str\n    target_path: str\n    location_type: str\n\n\nclass SimulateRequest(BaseModel):\n    type: str = \"temp_trojan\"\n\n\n# ==============================================================\n# REST API Endpoints\n# ==============================================================\n\n@app.get(\"/api/status\")\ndef get_system_status():\n    \"\"\"Retrieve overall system health, resource consumption, and detector metrics.\"\"\"\n    cpu_percent = psutil.cpu_percent(interval=None)\n    mem = psutil.virtual_memory()\n\n    return {\n        \"status\": \"ONLINE\",\n        \"timestamp\": datetime.now().isoformat(),\n        \"cpu_percent\": cpu_percent,\n        \"memory_percent\": mem.percent,\n        \"memory_used_gb\": round(mem.used / (1024 ** 3), 2),\n        \"memory_total_gb\": round(mem.total / (1024 ** 3), 2),\n        \"platform\": sys.platform,\n        \"process_count\": len(psutil.pids())\n    }\n\n\n@app.get(\"/api/scan\")\ndef run_scan(detailed: bool = False):\n    \"\"\"\n    Execute full process scan across all active processes.\n    Identifies threats, calculates scores, and returns categorized telemetry.\n    \"\"\"\n    procs = detector.scan_all_processes(detailed_pe=detailed)\n\n    threats = [p for p in procs if p.get(\"is_threat\")]\n    critical_threats = [p for p in threats if p.get(\"severity\") == \"CRITICAL\"]\n    high_threats = [p for p in threats if p.get(\"severity\") == \"HIGH\"]\n    rmm_tools = [p for p in procs if \"REMOTE CONTROL\" in p.get(\"primary_category\", \"\") or any(\"Remote Desktop\" in r.get(\"vector\", \"\") for r in p.get(\"reasons\", []))]\n\n    # System Health Index (100 = safe, 0 = critical breach)\n    threat_index = 100 - min(len(critical_threats) * 35 + len(high_threats) * 15, 100)\n\n    return {\n        \"scan_time\": datetime.now().isoformat(),\n        \"total_processes\": len(procs),\n        \"total_threats\": len(threats),\n        \"critical_count\": len(critical_threats),\n        \"high_count\": len(high_threats),\n        \"rmm_count\": len(rmm_tools),\n        \"system_health_index\": threat_index,\n        \"threats\": threats,\n        \"rmm_tools\": rmm_tools,\n        \"processes\": procs\n    }\n\n\n@app.get(\"/api/process/{pid}\")\ndef inspect_single_process(pid: int):\n    \"\"\"Deep inspect a single process with full PE analysis, sockets, and metadata.\"\"\"\n    if not psutil.pid_exists(pid):\n        raise HTTPException(status_code=404, detail=\"Process not found\")\n\n    try:\n        proc = psutil.Process(pid)\n        analyzed = detector.evaluate_process(proc, detailed_pe=True)\n        if not analyzed:\n            raise HTTPException(status_code=404, detail=\"Process could not be analyzed\")\n        return analyzed\n    except Exception as e:\n        raise HTTPException(status_code=500, detail=str(e))\n\n\n@app.post(\"/api/kill\")\ndef kill_process(req: KillRequest):\n    \"\"\"Terminate a single process by PID.\"\"\"\n    result = remediator.kill_process(req.pid, force=req.force, reason=req.reason)\n    return result\n\n\n@app.post(\"/api/kill-tree\")\ndef kill_process_tree(req: KillRequest):\n    \"\"\"Terminate a parent process and all child processes recursively.\"\"\"\n    result = remediator.kill_process_tree(req.pid, reason=req.reason)\n    return result\n\n\n@app.post(\"/api/kill-all-threats\")\ndef kill_all_threats(req: KillAllRequest):\n    \"\"\"Emergency bulk kill for all detected threats exceeding threshold.\"\"\"\n    procs = detector.scan_all_processes(detailed_pe=False)\n    threats = [p for p in procs if p.get(\"is_threat\")]\n    result = remediator.kill_all_threats(threats, min_score=req.min_score)\n    return result\n\n\n@app.post(\"/api/quarantine\")\ndef quarantine_binary(req: QuarantineRequest):\n    \"\"\"Quarantine a suspicious executable file.\"\"\"\n    result = remediator.quarantine_file(req.file_path, reason=req.reason)\n    return result\n\n\n@app.get(\"/api/rmm\")\ndef get_rmm_overview():\n    \"\"\"Retrieve dedicated overview of remote desktop & RMM tools and sockets.\"\"\"\n    procs = detector.scan_all_processes(detailed_pe=False)\n    rmm_procs = [\n        p for p in procs\n        if \"REMOTE CONTROL\" in p.get(\"primary_category\", \"\")\n        or any(\"Remote Desktop\" in r.get(\"vector\", \"\") for r in p.get(\"reasons\", []))\n    ]\n    return {\n        \"timestamp\": datetime.now().isoformat(),\n        \"total_active_rmm\": len(rmm_procs),\n        \"rmm_processes\": rmm_procs\n    }\n\n\n@app.get(\"/api/persistence\")\ndef get_persistence():\n    \"\"\"Scan and retrieve startup folders, registry keys, and scheduled tasks.\"\"\"\n    entries = get_all_persistence_entries()\n    suspicious = [e for e in entries if e.get(\"is_suspicious\")]\n    return {\n        \"total\": len(entries),\n        \"suspicious_count\": len(suspicious),\n        \"entries\": entries\n    }\n\n\n@app.post(\"/api/persistence/disable\")\ndef disable_persistence(req: PersistenceDisableRequest):\n    \"\"\"Disable or remove an autorun persistence mechanism.\"\"\"\n    result = disable_persistence_item(req.id, req.target_path, req.location_type)\n    return result\n\n\n@app.get(\"/api/audit-log\")\ndef get_audit_log(limit: int = 100):\n    \"\"\"Retrieve recent remediation actions, kills, and scan audit logs.\"\"\"\n    return remediator.get_audit_log(limit=limit)\n\n\n@app.post(\"/api/simulator/spawn\")\ndef spawn_test_threat(req: SimulateRequest):\n    \"\"\"Spawn a harmless test process mimicking threat behavior for safe verification.\"\"\"\n    result = spawn_simulated_threat(req.type)\n    return result\n\n\n@app.post(\"/api/simulator/cleanup\")\ndef cleanup_simulations():\n    \"\"\"Clean up any active test simulations.\"\"\"\n    result = stop_all_simulations()\n    return result\n\n\n# ==============================================================\n# WebSockets Real-Time Telemetry Stream\n# ==============================================================\n\n@app.websocket(\"/ws/telemetry\")\nasync def websocket_telemetry(websocket: WebSocket):\n    \"\"\"High-frequency telemetry stream pushing CPU, RAM, and quick threat stats.\"\"\"\n    await websocket.accept()\n    try:\n        while True:\n            cpu = psutil.cpu_percent(interval=None)\n            mem = psutil.virtual_memory()\n            pids_count = len(psutil.pids())\n\n            data = {\n                \"timestamp\": datetime.now().isoformat(),\n                \"time_display\": datetime.now().strftime(\"%H:%M:%S\"),\n                \"cpu_percent\": cpu,\n                \"memory_percent\": mem.percent,\n                \"process_count\": pids_count\n            }\n            await websocket.send_json(data)\n            await asyncio.sleep(2.0)\n    except WebSocketDisconnect:\n        pass\n    except Exception:\n        pass\n\n\n# ==============================================================\n# Mount Static Frontend\n# ==============================================================\n\nif FRONTEND_DIR.exists():\n    app.mount(\"/static\", StaticFiles(directory=str(FRONTEND_DIR)), name=\"static\")\n\n    @app.get(\"/\")\n    def serve_dashboard():\n        index_file = FRONTEND_DIR / \"index.html\"\n        if index_file.exists():\n            return FileResponse(index_file)\n        return JSONResponse({\"status\": \"AegisShield Backend Running\", \"message\": \"Frontend UI file missing\"})\n","Overwrite":true,"Path":"c:\\Users\\thann\\Downloads\\AntiGravity\\SpywareProcessMon\\backend\\server.py"}}]}
