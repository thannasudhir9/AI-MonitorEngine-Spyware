  self.failed += 1\n53:             print(f\"  {RED}[FAIL]{RESET} {test_name} - {RED}{detail}{RESET}\")\n54:         self.results.append({\"name\": test_name, \"success\": success, \"detail\": detail})\n55: \n56: \n57: def run_all_tests():\n58:     print(f\"\"\"{CYAN}{BOLD}\n59:     ╔══════════════════════════════════════════════════════════════╗\n60:     ║       AEGISSHIELD MASTER DIAGNOSTIC & TESTING ENGINE         ║\n61:     ║   Automated E2E Verification Suite for All Subsystems        ║\n62:     ╚══════════════════════════════════════════════════════════════╝{RESET}\n63:     \"\"\")\n64: \n65:     runner = TestRunner()\n66: \n67:     # ==============================================================\n68:     # Test Suite 1: Threat Detection Engine\n69:     # ==============================================================\n70:     print(f\"\\n{BOLD}[1/8] Testing Threat Detection & Heuristic Scoring Engine...{RESET}\")\n71:     detector = ThreatDetector()\n72:     procs = detector.scan_all_processes(detailed_pe=False)\n73:     runner.record(\"Process Enumeration\", len(procs) > 0, f\"Scanned {len(procs)} processes\")\n74: \n75:     # Masquerading detection\n76:     sim_threat = detector.evaluate_process(psutil.Process(psutil.pids()[0]))\n77:     runner.record(\"Process Evaluation\", sim_threat is not None, f\"Evaluated PID {psutil.pids()[0]}\")\n78: \n79:     # ==============================================================\n80:     # Test Suite 2: Process Eradication & Remediation\n81:     # ==============================================================\n82:     print(f\"\\n{BOLD}[2/8] Testing Remediation & Eradication Engine...{RESET}\")\n83:     remediator = ThreatRemediator()\n84:     sim = spawn_simulated_threat(\"encoded_cmdline\")\n85:     test_pid = sim[\"pid\"]\n86:     runner.record(\"Threat Simulation\", sim[\"success\"], f\"Spawned test PID {test_pid}\")\n87: \n88:     kill_res = remediator.kill_process(test_pid, force=True, reason=\"Test Engine Kill\")\n89:     time.sleep(0.3)\n90:     is_dead = not psutil.pid_exists(test_pid)\n91:     runner.record(\"Process Eradication (Kill)\", is_dead, f\"Terminated PID {test_pid} successfully\")\n92: \n93:     # ==============================================================\n94:     # Test Suite 3: Access Control Policy Engine (Allow / Block)\n95:     # ==============================================================\n96:     print(f\"\\n{BOLD}[3/8] Testing Access Control (Allowlist & Blocklist) Engine...{RESET}\")\n97:     policy = PolicyEngine()\n98:     allow_res = policy.add_allow_rule(\"name\", \"safe_unit_test.exe\", \"Diagnostic check\")\n99:     runner.record(\"Add Allow Rule\", allow_res[\"success\"], allow_res[\"message\"])\n100: "}
