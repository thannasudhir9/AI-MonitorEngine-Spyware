{"step_index":171,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-07T06:11:35Z","input_tokens":3131,"cache_read_tokens":141578,"output_tokens":11607,"tool_calls":[{"name":"write_file","args":{"Content":"<!DOCTYPE html>\n<html lang=\"en\" class=\"dark\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>AegisShield | Cyber Threat Hunter, Process Monitor & Eradicator</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        tailwind.config = {\n            darkMode: 'class',\n            theme: {\n                extend: {\n                    colors: {\n                        cyber: {\n                            900: '#080c14',\n                            800: '#0f172a',\n                            700: '#131c31',\n                            card: '#111a2e',\n                            cyan: '#06b6d4',\n                            emerald: '#10b981',\n                            crimson: '#ef4444',\n                            amber: '#f59e0b',\n                            purple: '#8b5cf6'\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n    <!-- Lucide Icons -->\n    <script src=\"https://unpkg.com/lucide@latest\"></script>\n    <!-- Custom Cyber Dashboard CSS -->\n    <link rel=\"stylesheet\" href=\"/static/css/dashboard.css\">\n</head>\n<body class=\"bg-cyber-900 text-slate-100 min-h-screen flex flex-col font-sans selection:bg-cyan-500 selection:text-black\">\n\n    <!-- Top Navigation Header -->\n    <header class=\"border-b border-slate-800 bg-cyber-900/90 backdrop-blur-md sticky top-0 z-40 px-6 py-3.5 flex items-center justify-between\">\n        <!-- Brand & Shield Indicator -->\n        <div class=\"flex items-center gap-4\">\n            <div class=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-600 to-emerald-500 p-0.5 shadow-lg shadow-cyan-500/20 flex items-center justify-center\">\n                <div class=\"w-full h-full bg-cyber-900 rounded-[10px] flex items-center justify-center text-cyan-400\">\n                    <i data-lucide=\"shield-alert\" class=\"w-5 h-5\"></i>\n                </div>\n            </div>\n            <div>\n                <div class=\"flex items-center gap-2\">\n                    <h1 class=\"font-extrabold text-lg tracking-wider font-mono text-white\">AEGIS<span class=\"text-cyan-400\">SHIELD</span></h1>\n                    <span class=\"px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 text-[10px] font-mono font-bold\">EDR v2.0</span>\n                </div>\n                <p class=\"text-xs text-slate-400\">Spyware, Antivirus, Remote Desktop & Network Origin Hunter</p>\n            </div>\n        </div>\n\n        <!-- Center System Status Badge -->\n        <div class=\"hidden md:flex items-center gap-3\">\n            <div id=\"system-status-indicator\" class=\"px-3.5 py-1 rounded-full text-xs font-mono font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/50 flex items-center gap-2\">\n                <span class=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></span> SYSTEM PROTECTED & SECURE\n            </div>\n            <div class=\"text-xs font-mono text-slate-400\" id=\"live-time\">--:--:--</div>\n        </div>\n\n        <!-- Quick Action Buttons -->\n        <div class=\"flex items-center gap-2.5\">\n            <!-- Send Email Report Button -->\n            <button onclick=\"openEmailModal()\" class=\"px-3 py-1.5 rounded-lg bg-purple-600/30 hover:bg-purple-600 text-purple-200 text-xs font-mono border border-purple-500/40 flex items-center gap-1.5 transition\">\n                <i data-lucide=\"mail\" class=\"w-3.5 h-3.5\"></i> Email Report\n            </button>\n\n            <!-- Auto-Refresh Toggle -->\n            <button id=\"btn-auto-refresh\" onclick=\"toggleAutoRefresh()\" class=\"px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-mono text-slate-300 border border-slate-700 flex items-center gap-2 transition\">\n                <i data-lucide=\"refresh-cw\" class=\"w-3.5 h-3.5 text-emerald-400\"></i> Auto-Refresh: ON\n            </button>\n\n            <!-- Manual Deep Scan -->\n            <button id=\"btn-scan\" onclick=\"runScan(true)\" class=\"px-4 py-1.5 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-black font-bold text-xs font-mono flex items-center gap-1.5 shadow-lg shadow-cyan-600/30 transition\">\n                <i data-lucide=\"radar\" class=\"w-3.5 h-3.5\"></i> Deep Scan\n            </button>\n\n            <!-- Emergency Kill All Threats -->\n            <button onclick=\"emergencyKillAll()\" class=\"px-4 py-1.5 rounded-lg bg-red-600 hover:bg-red-500 text-white font-bold text-xs font-mono flex items-center gap-1.5 shadow-lg shadow-red-900/40 border border-red-500 transition animate-pulse\">\n                <i data-lucide=\"zap\" class=\"w-3.5 h-3.5\"></i> KILL ALL THREATS\n            </button>\n        </div>\n    </header>\n\n    <!-- Radar Scan Progress Indicator (Hidden by default) -->\n    <div id=\"scan-radar\" class=\"radar-sweep h-1 bg-cyan-500/20 w-full hidden\"></div>\n\n    <!-- Main Content Area -->\n    <main class=\"flex-1 max-w-7xl w-full mx-auto p-6 space-y-6\">\n\n        <!-- Metrics Overview Grid -->\n        <section class=\"grid grid-cols-2 md:grid-cols-5 gap-4\">\n            <!-- Total Processes Card -->\n            <div class=\"cyber-card p-4 flex flex-col justify-between\">\n                <div class=\"flex items-center justify-between text-slate-400 text-xs font-mono\">\n                    <span>ACTIVE PROCESSES</span>\n                    <i data-lucide=\"cpu\" class=\"w-4 h-4 text-cyan-400\"></i>\n                </div>\n                <div class=\"mt-2 flex items-baseline gap-2\">\n                    <span id=\"stat-total-procs\" class=\"text-2xl font-bold font-mono text-white\">--</span>\n                    <span class=\"text-xs text-slate-400\">PIDs</span>\n                </div>\n                <div class=\"text-[11px] font-mono text-slate-500 mt-1\">CPU: <span id=\"stat-cpu\" class=\"text-cyan-400\">--%</span> | RAM: <span id=\"stat-memory\" class=\"text-cyan-400\">--%</span></div>\n            </div>\n\n            <!-- Total Flagged Threats Card -->\n            <div class=\"cyber-card p-4 flex flex-col justify-between border-l-4 border-amber-500\">\n                <div class=\"flex items-center justify-between text-slate-400 text-xs font-mono\">\n                    <span>FLAGGED THREATS</span>\n                    <i data-lucide=\"alert-octagon\" class=\"w-4 h-4 text-amber-400\"></i>\n                </div>\n                <div class=\"mt-2 flex items-baseline gap-2\">\n                    <span id=\"stat-threats\" class=\"text-2xl font-bold font-mono text-amber-400\">0</span>\n                    <span class=\"text-xs text-slate-400\">Risks</span>\n                </div>\n                <div class=\"text-[11px] font-mono text-slate-500 mt-1\">Behavioral & Signatures</div>\n            </div>\n\n            <!-- Critical Threats Card -->\n            <div class=\"cyber-card p-4 flex flex-col justify-between border-l-4 border-red-500\">\n                <div class=\"flex items-center justify-between text-slate-400 text-xs font-mono\">\n                    <span>CRITICAL THREATS</span>\n                    <i data-lucide=\"skull\" class=\"w-4 h-4 text-red-500\"></i>\n                </div>\n                <div class=\"mt-2 flex items-baseline gap-2\">\n                    <span id=\"stat-critical\" class=\"text-2xl font-bold font-mono text-red-400\">0</span>\n                    <span class=\"text-xs text-slate-400\">Immediate Kill</span>\n                </div>\n                <div class=\"text-[11px] font-mono text-red-400/80 mt-1\">Trojan / RAT / Infostealer</div>\n            </div>\n\n            <!-- Remote Desktop & RMM Card -->\n            <div class=\"cyber-card p-4 flex flex-col justify-between border-l-4 border-cyan-500\">\n                <div class=\"flex items-center justify-between text-slate-400 text-xs font-mono\">\n                    <span>REMOTE DESKTOP / RMM</span>\n                    <i data-lucide=\"screen-share\" class=\"w-4 h-4 text-cyan-400\"></i>\n                </div>\n                <div class=\"mt-2 flex items-baseline gap-2\">\n                    <span id=\"stat-rmm\" class=\"text-2xl font-bold font-mono text-cyan-300\">0</span>\n                    <span class=\"text-xs text-slate-400\">Active Sessions</span>\n                </div>\n                <div class=\"text-[11px] font-mono text-slate-500 mt-1\">AnyDesk, VNC, RustDesk...</div>\n            </div>\n\n            <!-- System Threat Index Card -->\n            <div class=\"cyber-card p-4 flex flex-col justify-between border-l-4 border-emerald-500\">\n                <div class=\"flex items-center justify-between text-slate-400 text-xs font-mono\">\n                    <span>HEALTH INDEX</span>\n                    <i data-lucide=\"shield-check\" class=\"w-4 h-4 text-emerald-400\"></i>\n                </div>\n                <div class=\"mt-2 flex items-baseline gap-2\">\n                    <span id=\"stat-health\" class=\"text-2xl font-bold font-mono text-emerald-400\">100%</span>\n                    <span class=\"text-xs text-slate-400\">Secure</span>\n                </div>\n                <div class=\"text-[11px] font-mono text-slate-500 mt-1\">SOC Readiness Score</div>\n            </div>\n        </section>\n\n        <!-- Navigation Tabs Bar -->\n        <nav class=\"flex border-b border-slate-800 gap-1 overflow-x-auto pb-1 text-sm font-mono\">\n            <button data-tab=\"threats\" class=\"tab-btn px-4 py-2.5 rounded-t-lg bg-cyan-500/20 text-cyan-300 border-b-2 border-cyan-500 flex items-center gap-2 font-medium\">\n                <i data-lucide=\"shield-alert\" class=\"w-4 h-4\"></i> Active Threats & Remediation\n            </button>\n            <button data-tab=\"network\" class=\"tab-btn px-4 py-2.5 rounded-t-lg text-slate-400 border-b-2 border-transparent hover:text-white flex items-center gap-2 font-medium\">\n                <i data-lucide=\"globe\" class=\"w-4 h-4 text-emerald-400\"></i> Network Radar & Origin Tracer\n            </button>\n            <button data-tab=\"rmm\" class=\"tab-btn px-4 py-2.5 rounded-t-lg text-slate-400 border-b-2 border-transparent hover:text-white flex items-center gap-2 font-medium\">\n                <i data-lucide=\"radio\" class=\"w-4 h-4\"></i> Remote Desktop & RAT Hunter\n            </button>\n            <button data-tab=\"processes\" class=\"tab-btn px-4 py-2.5 rounded-t-lg text-slate-400 border-b-2 border-transparent hover:text-white flex items-center gap-2 font-medium\">\n                <i data-lucide=\"list-tree\" class=\"w-4 h-4\"></i> Live Process Monitor\n            </button>\n            <button data-tab=\"policy\" class=\"tab-btn px-4 py-2.5 rounded-t-lg text-slate-400 border-b-2 border-transparent hover:text-white flex items-center gap-2 font-medium\">\n                <i data-lucide=\"shield-check\" class=\"w-4 h-4 text-cyan-400\"></i> Access Control & Rules\n            </button>\n            <button data-tab=\"persistence\" class=\"tab-btn px-4 py-2.5 rounded-t-lg text-slate-400 border-b-2 border-transparent hover:text-white flex items-center gap-2 font-medium\">\n                <i data-lucide=\"rocket\" class=\"w-4 h-4\"></i> Persistence & Startup\n            </button>\n            <button data-tab=\"simulation\" class=\"tab-btn px-4 py-2.5 rounded-t-lg text-slate-400 border-b-2 border-transparent hover:text-white flex items-center gap-2 font-medium\">\n                <i data-lucide=\"flask-conical\" class=\"w-4 h-4 text-purple-400\"></i> Simulation Lab\n            </button>\n            <button data-tab=\"email\" class=\"tab-btn px-4 py-2.5 rounded-t-lg text-slate-400 border-b-2 border-transparent hover:text-white flex items-center gap-2 font-medium\">\n                <i data-lucide=\"mail\" class=\"w-4 h-4 text-amber-400\"></i> Email Alerts\n            </button>\n            <button data-tab=\"audit\" class=\"tab-btn px-4 py-2.5 rounded-t-lg text-slate-400 border-b-2 border-transparent hover:text-white flex items-center gap-2 font-medium\">\n                <i data-lucide=\"history\" class=\"w-4 h-4\"></i> Incident Audit Log\n            </button>\n        </nav>\n\n        <!-- ========================================== -->\n        <!-- TAB 1: ACTIVE THREATS & REMEDIATION -->\n        <!-- ========================================== -->\n        <section id=\"view-threats\" class=\"tab-content space-y-4\">\n            <div class=\"flex items-center justify-between\">\n                <div>\n                    <h2 class=\"text-base font-bold font-mono text-white\">Active Threat Vectors</h2>\n                    <p class=\"text-xs text-slate-400\">Processes exceeding risk thresholds via signatures, LOLRMM, masquerading, policy violations, or injected APIs.</p>\n                </div>\n                <div class=\"text-xs text-slate-400 font-mono\">\n                    Showing real-time detections with direct kill, allow, and block controls\n                </div>\n            </div>\n\n            <!-- Threats Grid Container -->\n            <div id=\"threats-grid\" class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                <!-- Rendered dynamically by JavaScript -->\n            </div>\n        </section>\n\n        <!-- ========================================== -->\n        <!-- TAB 2: NETWORK RADAR & IP ORIGIN TRACER -->\n        <!-- ========================================== -->\n        <section id=\"view-network\" class=\"tab-content hidden space-y-4\">\n            <!-- Network Statistics Row -->\n            <div class=\"grid grid-cols-2 md:grid-cols-5 gap-3 font-mono text-xs\">\n                <div class=\"cyber-card p-3\">\n                    <div class=\"text-slate-400\">Processes On Network</div>\n                    <div id=\"net-stat-procs\" class=\"text-lg font-bold text-white mt-1\">--</div>\n                </div>\n                <div class=\"cyber-card p-3\">\n                    <div class=\"text-slate-400\">Active Outbound Sockets</div>\n                    <div id=\"net-stat-established\" class=\"text-lg font-bold text-cyan-400 mt-1\">--</div>\n                </div>\n                <div class=\"cyber-card p-3\">\n                    <div class=\"text-slate-400\">Listening Server Ports</div>\n                    <div id=\"net-stat-listening\" class=\"text-lg font-bold text-amber-400 mt-1\">--</div>\n                </div>\n                <div class=\"cyber-card p-3\">\n                    <div class=\"text-slate-400\">Verified Cloud / CDNs</div>\n                    <div id=\"net-stat-genuine\" class=\"text-lg font-bold text-emerald-400 mt-1\">--</div>\n                </div>\n                <div class=\"cyber-card p-3 border-l-2 border-red-500\">\n                    <div class=\"text-slate-400\">Suspicious Endpoints</div>\n                    <div id=\"net-stat-suspicious\" class=\"text-lg font-bold text-red-400 mt-1\">--</div>\n                </div>\n            </div>\n\n            <!-- Network Filter Controls -->\n            <div class=\"flex flex-col sm:flex-row items-center justify-between gap-3\">\n                <div class=\"relative w-full sm:w-80\">\n                    <i data-lucide=\"search\" class=\"w-4 h-4 text-slate-500 absolute left-3 top-2.5\"></i>\n                    <input \n                        type=\"text\" \n                        id=\"net-search\" \n                        oninput=\"filterNetworkTable()\" \n                        placeholder=\"Filter by Process, IP, or Domain...\" \n                        class=\"w-full bg-slate-900/90 border border-slate-800 rounded-lg pl-9 pr-4 py-2 text-xs font-mono text-white focus:outline-none focus:border-cyan-500 placeholder-slate-500\"\n                    >\n                </div>\n\n                <div class=\"flex items-center gap-1.5 w-full sm:w-auto font-mono text-xs overflow-x-auto\">\n                    <button onclick=\"setNetFilter('all')\" data-net-filter=\"all\" class=\"net-filter-btn px-3 py-1.5 rounded-lg bg-cyan-600 text-white font-medium\">All Sockets</button>\n                    <button onclick=\"setNetFilter('external')\" data-net-filter=\"external\" class=\"net-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:text-white\">Public External</button>\n                    <button onclick=\"setNetFilter('suspicious')\" data-net-filter=\"suspicious\" class=\"net-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:text-white\">Suspicious</button>\n                    <button onclick=\"setNetFilter('genuine')\" data-net-filter=\"genuine\" class=\"net-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:text-white\">Verified CDNs</button>\n                    <button onclick=\"setNetFilter('listening')\" data-net-filter=\"listening\" class=\"net-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:text-white\">Listening Daemons</button>\n                    <button onclick=\"loadNetworkTracer()\" class=\"px-3 py-1.5 rounded-lg bg-slate-800 text-cyan-400 hover:bg-slate-700 flex items-center gap-1\">\n                        <i data-lucide=\"refresh-cw\" class=\"w-3.5 h-3.5\"></i>\n                    </button>\n                </div>\n            </div>\n\n            <!-- Network Table -->\n            <div class=\"cyber-card overflow-hidden\">\n                <div class=\"overflow-x-auto max-h-[550px] overflow-y-auto\">\n                    <table class=\"w-full text-left text-xs font-mono\">\n                        <thead class=\"bg-slate-900/90 border-b border-slate-800 text-slate-400 sticky top-0 z-10\">\n                            <tr>\n                                <th class=\"p-3\">Process (PID)</th>\n                                <th class=\"p-3\">Local Socket</th>\n                                <th class=\"p-3\">Remote Endpoint</th>\n                                <th class=\"p-3\">Reverse DNS / Organization</th>\n                                <th class=\"p-3\">Genuineness Verdict</th>\n                                <th class=\"p-3\">State</th>\n                                <th class=\"p-3 text-right\">Actions</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"net-table-body\">\n                            <!-- Populated dynamically -->\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </section>\n\n        <!-- ========================================== -->\n        <!-- TAB 3: REMOTE DESKTOP & RAT HUNTER -->\n        <!-- ========================================== -->\n        <section id=\"view-rmm\" class=\"tab-content hidden space-y-4\">\n            <div class=\"flex items-center justify-between\">\n                <div>\n                    <h2 class=\"text-base font-bold font-mono text-cyan-300\">Remote Desktop, VNC, RMM & RAT Monitor</h2>\n                    <p class=\"text-xs text-slate-400\">Tracks AnyDesk, TeamViewer, RustDesk, ScreenConnect, VNC, and reverse ingress tunnels (LOLRMM).</p>\n                </div>\n            </div>\n\n            <div class=\"cyber-card overflow-hidden\">\n                <div class=\"overflow-x-auto\">\n                    <table class=\"w-full text-left text-xs font-mono\">\n                        <thead class=\"bg-slate-900/80 border-b border-slate-800 text-slate-400\">\n                            <tr>\n                                <th class=\"p-3\">Software / Tool</th>\n                                <th class=\"p-3\">PID</th>\n                                <th class=\"p-3\">Category</th>\n                                <th class=\"p-3\">Executable Path</th>\n                                <th class=\"p-3\">Network Sockets / Ports</th>\n                                <th class=\"p-3 text-right\">Action</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"rmm-table-body\">\n                            <!-- Populated dynamically -->\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </section>\n\n        <!-- ========================================== -->\n        <!-- TAB 4: LIVE PROCESS MONITOR -->\n        <!-- ========================================== -->\n        <section id=\"view-processes\" class=\"tab-content hidden space-y-4\">\n            <!-- Search & Filter Controls -->\n            <div class=\"flex flex-col sm:flex-row items-center justify-between gap-3\">\n                <div class=\"relative w-full sm:w-96\">\n                    <i data-lucide=\"search\" class=\"w-4 h-4 text-slate-500 absolute left-3 top-2.5\"></i>\n                    <input \n                        type=\"text\" \n                        id=\"process-search\" \n                        oninput=\"setSearchQuery(this.value)\" \n                        placeholder=\"Search by PID, Name, Path, or User...\" \n                        class=\"w-full bg-slate-900/90 border border-slate-800 rounded-lg pl-9 pr-4 py-2 text-xs font-mono text-white focus:outline-none focus:border-cyan-500 placeholder-slate-500\"\n                    >\n                </div>\n\n                <div class=\"flex items-center gap-1.5 w-full sm:w-auto font-mono text-xs\">\n                    <button onclick=\"setProcessFilter('all')\" data-filter=\"all\" class=\"proc-filter-btn px-3 py-1.5 rounded-lg bg-cyan-600 text-white font-medium\">All</button>\n                    <button onclick=\"setProcessFilter('threats')\" data-filter=\"threats\" class=\"proc-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:text-white\">Threats Only</button>\n                    <button onclick=\"setProcessFilter('rmm')\" data-filter=\"rmm\" class=\"proc-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:text-white\">Remote Control</button>\n                    <button onclick=\"setProcessFilter('high_cpu')\" data-filter=\"high_cpu\" class=\"proc-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:text-white\">High CPU</button>\n                </div>\n            </div>\n\n            <!-- Process Explorer Table -->\n            <div class=\"cyber-card overflow-hidden\">\n                <div class=\"overflow-x-auto max-h-[550px] overflow-y-auto\">\n                    <table class=\"w-full text-left text-xs\">\n                        <thead class=\"bg-slate-900/90 border-b border-slate-800 text-slate-400 font-mono sticky top-0 z-10\">\n                            <tr>\n                                <th class=\"p-3 w-16\">PID</th>\n                                <th class=\"p-3\">Process Name & Path</th>\n                                <th class=\"p-3 w-28\">Threat Level</th>\n                                <th class=\"p-3 w-20\">CPU</th>\n                                <th class=\"p-3 w-24\">Memory</th>\n                                <th class=\"p-3 w-36\">User</th>\n                                <th class=\"p-3 text-right w-48\">Actions</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"process-table-body\">\n                            <!-- Populated dynamically -->\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </section>\n\n        <!-- ========================================== -->\n        <!-- TAB 5: ACCESS CONTROL & ALLOW / BLOCK RULES -->\n        <!-- ========================================== -->\n        <section id=\"view-policy\" class=\"tab-content hidden space-y-4\">\n            <div class=\"flex items-center justify-between\">\n                <div>\n                    <h2 class=\"text-base font-bold font-mono text-white\">Access Control & Allow / Block Policy Rules</h2>\n                    <p class=\"text-xs text-slate-400\">Explicitly whitelist trusted software or blacklist malicious processes and remote IP addresses.</p>\n                </div>\n                <button onclick=\"openAddRuleModal()\" class=\"px-3 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-black font-bold text-xs font-mono rounded flex items-center gap-1.5 shadow\">\n                    <i data-lucide=\"plus-circle\" class=\"w-3.5 h-3.5\"></i> Add Custom Rule\n                </button>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                <!-- Allowed Processes (Whitelist) -->\n                <div class=\"cyber-card p-4 flex flex-col justify-between border-t-2 border-emerald-500\">\n                    <div>\n                        <div class=\"flex items-center justify-between text-xs font-mono mb-2\">\n                            <span class=\"font-bold text-emerald-400 flex items-center gap-1.5\">\n                                <i data-lucide=\"check-circle\" class=\"w-4 h-4\"></i> Allowed (Whitelisted)\n                            </span>\n                            <span id=\"policy-count-allowed\" class=\"text-slate-400\">0 rules</span>\n                        </div>\n                        <p class=\"text-[11px] text-slate-400 mb-3\">Processes that bypass all heuristics and are never terminated.</p>\n                        <div id=\"policy-list-allowed\" class=\"space-y-2 max-h-72 overflow-y-auto\">\n                            <!-- Populated dynamically -->\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Blocked Processes (Blacklist) -->\n                <div class=\"cyber-card p-4 flex flex-col justify-between border-t-2 border-red-500\">\n                    <div>\n                        <div class=\"flex items-center justify-between text-xs font-mono mb-2\">\n                            <span class=\"font-bold text-red-400 flex items-center gap-1.5\">\n                                <i data-lucide=\"ban\" class=\"w-4 h-4\"></i> Blocked Processes (Blacklist)\n                            </span>\n                            <span id=\"policy-count-blocked\" class=\"text-slate-400\">0 rules</span>\n                        </div>\n                        <p class=\"text-[11px] text-slate-400 mb-3\">Processes banned by policy, flagged as Critical on sight.</p>\n                        <div id=\"policy-list-blocked\" class=\"space-y-2 max-h-72 overflow-y-auto\">\n                            <!-- Populated dynamically -->\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Blocked IP Addresses -->\n                <div class=\"cyber-card p-4 flex flex-col justify-between border-t-2 border-amber-500\">\n                    <div>\n                        <div class=\"flex items-center justify-between text-xs font-mono mb-2\">\n                            <span class=\"font-bold text-amber-400 flex items-center gap-1.5\">\n                                <i data-lucide=\"shield-x\" class=\"w-4 h-4\"></i> Banned IP Addresses\n                            </span>\n                            <span id=\"policy-count-ips\" class=\"text-slate-400\">0 rules</span>\n                        </div>\n                        <p class=\"text-[11px] text-slate-400 mb-3\">Remote IPs blocked via Windows Firewall & active connection bans.</p>\n                        <div id=\"policy-list-ips\" class=\"space-y-2 max-h-72 overflow-y-auto\">\n                            <!-- Populated dynamically -->\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- ========================================== -->\n        <!-- TAB 6: PERSISTENCE & STARTUP -->\n        <!-- ========================================== -->\n        <section id=\"view-persistence\" class=\"tab-content hidden space-y-4\">\n            <div class=\"flex items-center justify-between\">\n                <div>\n                    <h2 class=\"text-base font-bold font-mono text-white\">Autoruns, Registry & Startup Persistence</h2>\n                    <p class=\"text-xs text-slate-400\">Scans HKCU/HKLM Run keys, Startup folders, and Scheduled Tasks for hidden persistence.</p>\n                </div>\n                <button onclick=\"loadPersistence()\" class=\"px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs font-mono text-slate-300 rounded border border-slate-700 flex items-center gap-1.5\">\n                    <i data-lucide=\"refresh-cw\" class=\"w-3.5 h-3.5\"></i> Rescan Autoruns\n                </button>\n            </div>\n\n            <div class=\"cyber-card overflow-hidden\">\n                <div class=\"overflow-x-auto\">\n                    <table class=\"w-full text-left text-xs font-mono\">\n                        <thead class=\"bg-slate-900/80 border-b border-slate-800 text-slate-400\">\n                            <tr>\n                                <th class=\"p-3\">Entry Name</th>\n                                <th class=\"p-3\">Location Vector</th>\n                                <th class=\"p-3\">Target Command / Path</th>\n                                <th class=\"p-3\">Status</th>\n                                <th class=\"p-3 text-right\">Action</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"persistence-table-body\">\n                            <!-- Populated dynamically -->\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </section>\n\n        <!-- ========================================== -->\n        <!-- TAB 7: SIMULATION LAB -->\n        <!-- ========================================== -->\n        <section id=\"view-simulation\" class=\"tab-content hidden space-y-4\">\n            <div class=\"cyber-card p-6 border-purple-500/40\">\n                <div class=\"flex items-start gap-4\">\n                    <div class=\"p-3 rounded-xl bg-purple-500/20 text-purple-400 border border-purple-500/30\">\n                        <i data-lucide=\"flask-conical\" class=\"w-8 h-8\"></i>\n                    </div>\n                    <div>\n                        <h2 class=\"text-lg font-bold font-mono text-white\">Safe Threat Simulation Sandbox</h2>\n                        <p class=\"text-xs text-slate-400 mt-1 max-w-2xl\">\n                            Verify AegisShield's detection and eradication engine safely! These scenarios spawn completely harmless background Python processes that exhibit real-world malware behavioral patterns (e.g., Temp drop zones, obfuscated LOLBins, remote desktop beacons).\n                        </p>\n                    </div>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 mt-6\">\n                    <!-- Scenario 1 -->\n                    <div class=\"p-4 bg-slate-900/60 rounded-xl border border-slate-800 flex flex-col justify-between\">\n                        <div>\n                            <div class=\"font-bold text-sm text-white font-mono\">Scenario 1: Temp Drop Trojan</div>\n                            <p class=\"text-xs text-slate-400 mt-1\">Spawns a benign process running out of %TEMP% mimicking a dropped Trojan payload.</p>\n                        </div>\n                        <button onclick=\"spawnTestSimulation('temp_trojan')\" class=\"mt-4 px-3 py-2 bg-purple-600/30 hover:bg-purple-600 text-purple-200 text-xs font-mono font-bold rounded border border-purple-500/50 flex items-center justify-center gap-2\">\n                            <i data-lucide=\"play\" class=\"w-3.5 h-3.5\"></i> Launch Temp Trojan\n                        </button>\n                    </div>\n\n                    <!-- Scenario 2 -->\n                    <div class=\"p-4 bg-slate-900/60 rounded-xl border border-slate-800 flex flex-col justify-between\">\n                        <div>\n                            <div class=\"font-bold text-sm text-white font-mono\">Scenario 2: Obfuscated LOLBin</div>\n                            <p class=\"text-xs text-slate-400 mt-1\">Launches a hidden process with base64/encoded download cradle flags.</p>\n                        </div>\n                        <button onclick=\"spawnTestSimulation('encoded_cmdline')\" class=\"mt-4 px-3 py-2 bg-purple-600/30 hover:bg-purple-600 text-purple-200 text-xs font-mono font-bold rounded border border-purple-500/50 flex items-center justify-center gap-2\">\n                            <i data-lucide=\"play\" class=\"w-3.5 h-3.5\"></i> Launch Encoded Cradle\n                        </button>\n                    </div>\n\n                    <!-- Scenario 3 -->\n                    <div class=\"p-4 bg-slate-900/60 rounded-xl border border-slate-800 flex flex-col justify-between\">\n                        <div>\n                            <div class=\"font-bold text-sm text-white font-mono\">Scenario 3: Remote Desktop Beacon</div>\n                            <p class=\"text-xs text-slate-400 mt-1\">Simulates an unauthorized VNC / RMM remote control session beacon.</p>\n                        </div>\n                        <button onclick=\"spawnTestSimulation('rmm_beacon')\" class=\"mt-4 px-3 py-2 bg-purple-600/30 hover:bg-purple-600 text-purple-200 text-xs font-mono font-bold rounded border border-purple-500/50 flex items-center justify-center gap-2\">\n                            <i data-lucide=\"play\" class=\"w-3.5 h-3.5\"></i> Launch RMM Beacon\n                        </button>\n                    </div>\n                </div>\n\n                <div class=\"mt-6 pt-4 border-t border-slate-800 flex justify-end\">\n                    <button onclick=\"cleanupSimulations()\" class=\"px-4 py-2 bg-slate-800 hover:bg-slate-700 text-xs font-mono text-slate-300 rounded border border-slate-700 flex items-center gap-2\">\n                        <i data-lucide=\"trash-2\" class=\"w-4 h-4 text-red-400\"></i> Terminate All Active Simulations\n                    </button>\n                </div>\n            </div>\n        </section>\n\n        <!-- ========================================== -->\n        <!-- TAB 8: EMAIL ALERTS & REPORT CONFIGURATION -->\n        <!-- ========================================== -->\n        <section id=\"view-email\" class=\"tab-content hidden space-y-4\">\n            <div class=\"cyber-card p-6 max-w-2xl mx-auto\">\n                <div class=\"flex items-center gap-3 border-b border-slate-800 pb-4 mb-4\">\n                    <div class=\"p-2.5 rounded-xl bg-purple-500/20 text-purple-400 border border-purple-500/30\">\n                        <i data-lucide=\"mail\" class=\"w-6 h-6\"></i>\n                    </div>\n                    <div>\n                        <h2 class=\"text-base font-bold font-mono text-white\">SMTP Email Alert & Report Dispatcher</h2>\n                        <p class=\"text-xs text-slate-400\">Configure SMTP credentials to receive automated HTML security posture reports and critical alerts.</p>\n                    </div>\n                </div>\n\n                <form onsubmit=\"handleSaveEmailConfig(event)\" class=\"space-y-4 font-mono text-xs\">\n                    <div class=\"grid grid-cols-2 gap-3\">\n                        <div>\n                            <label class=\"block text-slate-400 mb-1\">SMTP Server Host</label>\n                            <input type=\"text\" id=\"email-smtp-server\" placeholder=\"smtp.gmail.com\" class=\"w-full bg-slate-900 border border-slate-800 rounded p-2 text-white\">\n                        </div>\n                        <div>\n                            <label class=\"block text-slate-400 mb-1\">SMTP Port</label>\n                            <input type=\"number\" id=\"email-smtp-port\" placeholder=\"587\" class=\"w-full bg-slate-900 border border-slate-800 rounded p-2 text-white\">\n                        </div>\n                    </div>\n\n                    <div>\n                        <label class=\"block text-slate-400 mb-1\">Sender Email Address</label>\n                        <input type=\"email\" id=\"email-sender\" placeholder=\"security@yourdomain.com\" class=\"w-full bg-slate-900 border border-slate-800 rounded p-2 text-white\">\n                    </div>\n\n                    <div>\n                        <label class=\"block text-slate-400 mb-1\">App Password / Auth Token</label>\n                        <input type=\"password\" id=\"email-password\" placeholder=\"••••••••••••••••\" class=\"w-full bg-slate-900 border border-slate-800 rounded p-2 text-white\">\n                        <span class=\"text-[10px] text-slate-500\">For Gmail, generate an \"App Password\" in Google Account Security.</span>\n                    </div>\n\n                    <div>\n                        <label class=\"block text-slate-400 mb-1\">Default Recipient Email Address</label>\n                        <input type=\"email\" id=\"email-recipient\" placeholder=\"admin@yourdomain.com\" class=\"w-full bg-slate-900 border border-slate-800 rounded p-2 text-white\">\n                    </div>\n\n                    <div class=\"flex items-center gap-2 pt-2\">\n                        <input type=\"checkbox\" id=\"email-auto-alert\" class=\"rounded bg-slate-900 border-slate-800 text-cyan-600 focus:ring-0\">\n                        <label for=\"email-auto-alert\" class=\"text-slate-300\">Automatically dispatch email alert when a Critical threat is detected</label>\n                    </div>\n\n                    <div class=\"pt-4 border-t border-slate-800 flex items-center justify-between\">\n                        <button type=\"button\" onclick=\"sendTestEmail()\" class=\"px-3 py-2 bg-slate-800 hover:bg-slate-700 text-cyan-400 rounded border border-slate-700 flex items-center gap-1.5\">\n                            <i data-lucide=\"send\" class=\"w-3.5 h-3.5\"></i> Send Test Verification\n                        </button>\n                        <div class=\"flex gap-2\">\n                            <button type=\"button\" onclick=\"sendFullReport()\" class=\"px-3 py-2 bg-purple-600/30 hover:bg-purple-600 text-purple-200 rounded border border-purple-500/50 flex items-center gap-1.5 font-bold\">\n                                <i data-lucide=\"file-text\" class=\"w-3.5 h-3.5\"></i> Send Full Report Now\n                            </button>\n                            <button type=\"submit\" class=\"px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-black font-bold rounded\">\n                                Save Settings\n                            </button>\n                        </div>\n                    </div>\n                </form>\n            </div>\n        </section>\n\n        <!-- ========================================== -->\n        <!-- TAB 9: INCIDENT AUDIT LOG -->\n        <!-- ========================================== -->\n        <section id=\"view-audit\" class=\"tab-content hidden space-y-4\">\n            <div class=\"flex items-center justify-between\">\n                <div>\n                    <h2 class=\"text-base font-bold font-mono text-white\">Incident & Eradication Audit Trail</h2>\n                    <p class=\"text-xs text-slate-400\">Chronological ledger of scans, terminations, quarantines, email dispatches, and policy events.</p>\n                </div>\n                <div class=\"flex gap-2\">\n                    <button onclick=\"loadAuditLog()\" class=\"px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs font-mono text-slate-300 rounded border border-slate-700 flex items-center gap-1.5\">\n                        <i data-lucide=\"refresh-cw\" class=\"w-3.5 h-3.5\"></i> Refresh\n                    </button>\n                    <button onclick=\"exportAuditLog()\" class=\"px-3 py-1.5 bg-cyan-600/20 hover:bg-cyan-600/30 text-cyan-300 text-xs font-mono rounded border border-cyan-500/40 flex items-center gap-1.5\">\n                        <i data-lucide=\"download\" class=\"w-3.5 h-3.5\"></i> Export Report (JSON)\n                    </button>\n                </div>\n            </div>\n\n            <div class=\"cyber-card p-4\">\n                <div id=\"audit-log-container\" class=\"space-y-2 max-h-[500px] overflow-y-auto\">\n                    <!-- Populated dynamically -->\n                </div>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- Deep Process Inspection Modal -->\n    <div id=\"inspect-modal\" class=\"fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden\">\n        <div class=\"cyber-card max-w-2xl w-full p-6 max-h-[90vh] overflow-y-auto\" id=\"inspect-modal-content\">\n            <!-- Populated dynamically -->\n        </div>\n    </div>\n\n    <!-- Deep IP Tracer Modal -->\n    <div id=\"ip-trace-modal\" class=\"fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden\">\n        <div class=\"cyber-card max-w-lg w-full p-6 font-mono text-xs space-y-4\" id=\"ip-trace-modal-content\">\n            <!-- Populated dynamically -->\n        </div>\n    </div>\n\n    <!-- Add Custom Policy Rule Modal -->\n    <div id=\"add-rule-modal\" class=\"fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden\">\n        <div class=\"cyber-card max-w-md w-full p-6 font-mono text-xs space-y-4\">\n            <div class=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n                <h3 class=\"text-sm font-bold text-white\">Add Access Control Rule</h3>\n                <button onclick=\"closeAddRuleModal()\" class=\"text-slate-400 hover:text-white\">✕</button>\n            </div>\n            <form onsubmit=\"handleCreateRule(event)\" class=\"space-y-3\">\n                <div>\n                    <label class=\"block text-slate-400 mb-1\">Rule Policy Action</label>\n                    <select id=\"rule-action\" class=\"w-full bg-slate-900 border border-slate-800 rounded p-2 text-white\">\n                        <option value=\"allow\">Allowlist (Trust & Never Kill)</option>\n                        <option value=\"block\">Blocklist (Ban & Flag Critical)</option>\n                        <option value=\"block_ip\">Block Remote IP Address (Firewall)</option>\n                    </select>\n                </div>\n                <div>\n                    <label class=\"block text-slate-400 mb-1\">Match Type</label>\n                    <select id=\"rule-type\" class=\"w-full bg-slate-900 border border-slate-800 rounded p-2 text-white\">\n                        <option value=\"name\">Process Name (e.g. process.exe)</option>\n                        <option value=\"path\">Full Path (e.g. C:\\tools\\)</option>\n                        <option value=\"hash\">SHA256 Hash</option>\n                    </select>\n                </div>\n                <div>\n                    <label class=\"block text-slate-400 mb-1\">Target Value</label>\n                    <input type=\"text\" id=\"rule-value\" required placeholder=\"e.g. test_tool.exe or 198.51.100.1\" class=\"w-full bg-slate-900 border border-slate-800 rounded p-2 text-white\">\n                </div>\n                <div>\n                    <label class=\"block text-slate-400 mb-1\">Comment / Reason</label>\n                    <input type=\"text\" id=\"rule-comment\" placeholder=\"e.g. Verified internal administrative script\" class=\"w-full bg-slate-900 border border-slate-800 rounded p-2 text-white\">\n                </div>\n                <div class=\"pt-3 border-t border-slate-800 flex justify-end gap-2\">\n                    <button type=\"button\" onclick=\"closeAddRuleModal()\" class=\"px-3 py-1.5 bg-slate-800 text-slate-300 rounded\">Cancel</button>\n                    <button type=\"submit\" class=\"px-4 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-black font-bold rounded\">Create Rule</button>\n                </div>\n            </form>\n        </div>\n    </div>\n\n    <!-- Toast Notification Container -->\n    <div id=\"toast-container\"></div>\n\n    <!-- App JavaScript -->\n    <script src=\"/static/js/app.js\"></script>\n</body>\n</html>\n","Overwrite":true,"Path":"c:\\Users\\thann\\Downloads\\AntiGravity\\SpywareProcessMon\\frontend\\index.html"}}]}
