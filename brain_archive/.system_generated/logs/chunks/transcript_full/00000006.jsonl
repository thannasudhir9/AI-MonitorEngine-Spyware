n                    </button>\n                    <!-- Refresh -->\n                    <button onclick=\"loadAdBlockDashboard()\" class=\"px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyan-400 border border-slate-700 transition\" title=\"Refresh analytics\">\n                        <i data-lucide=\"refresh-cw\" class=\"w-3.5 h-3.5\"></i>\n                    </button>\n                </div>\n            </div>\n\n            <!-- AdBlock Metrics Cards -->\n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-3 font-mono text-xs\">\n                <div class=\"cyber-card p-3\">\n                    <div class=\"text-slate-400 flex items-center justify-between\">\n                        <span>SITES BROWSED</span>\n                        <i data-lucide=\"globe-2\" class=\"w-4 h-4 text-cyan-400\"></i>\n                    </div>\n                    <div id=\"adblock-stat-total\" class=\"text-xl font-bold text-white mt-1\">0</div>\n                    <div class=\"text-[10px] text-slate-500 mt-0.5\">Total Intercepted Requests</div>\n                </div>\n\n                <div class=\"cyber-card p-3 border-l-2 border-rose-500\">\n                    <div class=\"text-slate-400 flex items-center justify-between\">\n                        <span>ADS & TRACKERS BLOCKED</span>\n                        <i data-lucide=\"ban\" class=\"w-4 h-4 text-rose-400\"></i>\n                    </div>\n                    <div id=\"adblock-stat-blocked\" class=\"text-xl font-bold text-rose-400 mt-1\">0</div>\n                    <div class=\"text-[10px] text-rose-400/80 mt-0.5\">Ads, Beacons & Spyware</div>\n                </div>\n\n                <div class=\"cyber-card p-3\">\n                    <div class=\"text-slate-400 flex items-center justify-between\">\n                        <span>BLOCK PERCENTAGE</span>\n                        <i data-lucide=\"percent\" class=\"w-4 h-4 text-amber-400\"></i>\n                    </div>\n                    <div id=\"adblock-stat-rate\" class=\"text-xl font-bold text-amber-400 mt-1\">0%</div>\n                    <div class=\"text-[10px] text-slate-500 mt-0.5\">Efficiency Ratio</div>\n                </div>\n\n                <div class=\"cyber-card p-3 border-l-2 border-emerald-500\">\n                    <div class=\"text-slate-400 flex items-center justify-between\">\n                        <span>BANDWIDTH SAVED</span>\n                        <i data-lucide=\"zap\" class=\"w-4 h-4 text-emerald-400\"></i>\n                    </div>\n                    <div id=\"adblock-stat-saved\" class=\"text-xl font-bold text-emerald-400 mt-1\">0 MB</div>\n                    <div class=\"text-[10px] text-emerald-400/80 mt-0.5\">Data & Energy Preserved</div>\n                </div>\n            </div>\n\n            <!-- Analytics Visual Breakdown -->\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                <!-- Top Visited Websites -->\n                <div class=\"cyber-card p-4\">\n                    <h3 class=\"text-xs font-bold font-mono text-white mb-2 flex items-center gap-1.5\">\n                        <i data-lucide=\"compass\" class=\"w-4 h-4 text-cyan-400\"></i> Top Visited Websites\n                    </h3>\n                    <div id=\"adblock-top-visited\" class=\"space-y-2 max-h-60 overflow-y-auto text-xs font-mono\">\n                        <div class=\"text-slate-500 text-[11px] p-2\">No browsing activity recorded yet.</div>\n                    </div>\n                </div>\n\n                <!-- Top Blocked Ad Networks -->\n                <div class=\"cyber-card p-4\">\n                    <h3 class=\"text-xs font-bold font-mono text-rose-400 mb-2 flex items-center gap-1.5\">\n                        <i data-lucide=\"shield-alert\" class=\"w-4 h-4 text-rose-400\"></i> Top Blocked Ad Networks\n                    </h3>\n                    <div id=\"adblock-top-blocked\" class=\"space-y-2 max-h-60 overflow-y-auto text-xs font-mono\">\n                        <div class=\"text-slate-500 text-[11px] p-2\">No ad blocks recorded yet.</div>\n                    </div>\n                </div>\n\n                <!-- Categorical Distribution -->\n                <div class=\"cyber-card p-4\">\n                    <h3 class=\"text-xs font-bold font-mono text-amber-400 mb-2 flex items-center gap-1.5\">\n                        <i data-lucide=\"pie-chart\" class=\"w-4 h-4 text-amber-400\"></i> Traffic Distribution\n                    </h3>\n                    <div id=\"adblock-categories\" class=\"space-y-2 max-h-60 overflow-y-auto text-xs font-mono\">\n                        <div class=\"text-slate-500 text-[11px] p-2\">Awaiting browsing telemetry.</div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Live Web Browsing Feed Table -->\n            <div class=\"cyber-card overflow-hidden\">\n                <div class=\"p-3 border-b border-slate-800 bg-slate-900/60 flex flex-col sm:flex-row items-center justify-between gap-3\">\n                    <div class=\"relative w-full sm:w-80\">\n                        <i data-lucide=\"search\" class=\"w-4 h-4 text-slate-500 absolute left-3 top-2.5\"></i>\n                        <input \n                            type=\"text\" \n                            id=\"traffic-search\" \n                            oninput=\"filterTrafficTable()\" \n                            placeholder=\"Search browsed websites...\" \n                            class=\"w-full bg-slate-900 border border-slate-800 rounded-lg pl-9 pr-4 py-1.5 text-xs font-mono text-white focus:outline-none focus:border-rose-500 placeholder-slate-500\"\n                        >\n                    </div>\n\n                    <div class=\"flex items-center gap-1.5 font-mono text-xs w-full sm:w-auto\">\n                        <button onclick=\"setTrafficFilter('all')\" data-traffic-filter=\"all\" class=\"traffic-filter-btn px-3 py-1 rounded bg-rose-600 text-white font-medium\">All Traffic</button>\n                        <button onclick=\"setTrafficFilter('blocked')\" data-traffic-filter=\"blocked\" class=\"traffic-filter-btn px-3 py-1 rounded bg-slate-800 text-slate-400 hover:text-white\">Blocked Ads</button>\n                        <button onclick=\"setTrafficFilter('allowed')\" data-traffic-filter=\"allowed\" class=\"traffic-filter-btn px-3 py-1 rounded bg-slate-800 text-slate-400 hover:text-white\">Allowed Sites</button>\n                    </div>\n                </div>\n\n                <div class=\"overflow-x-auto max-h-[500px] overflow-y-auto\">\n                    <table class=\"w-full text-left text-xs font-mono\">\n                        <thead class=\"bg-slate-900/90 border-b border-slate-800 text-slate-400 sticky top-0 z-10\">\n                            <tr>\n                                <th class=\"p-3 w-44\">Date & Time</th>\n                                <th class=\"p-3\">Website / Target Domain</th>\n                                <th class=\"p-3 w-28\">Method & Port</th>\n                                <th class=\"p-3 w-40\">Category</th>\n                                <th class=\"p-3 w-28\">Status</th>\n                                <th class=\"p-3 text-right w-36\">Action</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"traffic-table-body\">\n                            <!-- Populated dynamically -->\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </section>","Target":"            <!-- Network Table -->\n            <div class=\"cyber-card overflow-hidden\">\n                <div class=\"overflow-x-auto max-h-[550px] overflow-y-auto\">\n                    <table class=\"w-full text-left text-xs font-mono\">\n                        <thead class=\"bg-slate-900/90 border-b border-slate-800 text-slate-400 sticky top-0 z-10\">\n              