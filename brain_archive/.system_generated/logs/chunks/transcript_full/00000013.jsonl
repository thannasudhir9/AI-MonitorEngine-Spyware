p Process Inspection Modal\n1040: async function inspectProcess(pid) {\n1041:     try {\n1042:         const res = await fetch(`/api/process/${pid}`);\n1043:         if (!res.ok) throw new Error('Process inspection failed');\n1044:         const p = await res.json();\n1045:         state.selectedProcess = p;\n1046: \n1047:         const modal = document.getElementById('inspect-modal');\n1048:         const content = document.getElementById('inspect-modal-content');\n1049:         if (!modal || !content) return;\n1050: \n1051:         content.innerHTML = `\n1052:             <div class=\"space-y-4\">\n1053:                 <div class=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n1054:                     <div>\n1055:                         <h3 class=\"text-lg font-bold font-mono text-cyan-400\">${escapeHtml(p.name)} (PID: ${p.pid})</h3>\n1056:                         <div class=\"text-xs text-slate-400 font-mono\">Parent: ${escapeHtml(p.parent_name || 'None')} (PPID: ${p.ppid})</div>\n1057:                     </div>\n1058:                     <span class=\"px-3 py-1 rounded text-xs font-mono font-bold ${p.threat_score >= 50 ? 'badge-critical' : 'badge-safe'}\">\n1059:                         Threat Score: ${p.threat_score}/100\n1060:                     </span>\n1061:                 </div>\n1062: \n1063:                 <div class=\"bg-slate-900/80 p-3 rounded-lg border border-slate-800 space-y-2 text-xs font-mono\">\n1064:                     <div><strong class=\"text-slate-400\">Path:</strong> <span class=\"text-slate-200 select-all\">${escapeHtml(p.exe || 'N/A')}</span></div>\n1065:                     <div><strong class=\"text-slate-400\">Command Line:</strong> <span class=\"text-slate-300 break-all\">${escapeHtml(p.cmdline || 'N/A')}</span></div>\n1066:                     <div><strong class=\"text-slate-400\">SHA256:</strong> <span class=\"text-cyan-400 select-all\">${p.pe_info?.hashes?.sha256 || 'N/A'}</span></div>\n1067:           