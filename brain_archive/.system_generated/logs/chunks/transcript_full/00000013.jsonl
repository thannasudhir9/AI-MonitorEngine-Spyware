{"step_index":653,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T07:00:53Z","content":"Created At: 2026-11-07T08:00:53+01:00\nCompleted At: 2026-11-07T08:00:53+01:00\nShowing lines 350-410 of 1690\n350:                 <!-- Action Controls: Allow, Block, Kill, Inspect -->\n351:                 <div class=\"mt-4 pt-3 border-t border-slate-800 flex items-center justify-between\">\n352:                     <div class=\"flex items-center gap-1.5\">\n353:                         <button onclick=\"quickAllowProcess('${escapeHtml(t.name)}', '${escapeHtml(t.exe)}')\" class=\"px-2.5 py-1 bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 text-xs font-mono rounded border border-emerald-500/40\" title=\"Whitelist and trust this process\">\n354:                             <i data-lucide=\"check\" class=\"w-3 h-3 inline\"></i> Allow\n355:                         </button>\n356:                         <button onclick=\"quickBlockProcess('${escapeHtml(t.name)}', '${escapeHtml(t.exe)}')\" class=\"px-2.5 py-1 bg-red-600/20 hover:bg-red-600/30 text-red-300 text-xs font-mono rounded border border-red-500/40\" title=\"Blacklist and ban this process\">\n357:                             <i data-lucide=\"ban\" class=\"w-3 h-3 inline\"></i> Block\n358:                         </button>\n359:                     </div>\n360:                     <div class=\"flex items-center gap-2\">\n361:                         <button onclick=\"inspectProcess(${t.pid})\" class=\"px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs font-mono text-slate-300 rounded border border-slate-700 transition\">\n362:                             Inspect\n363:                         </button>\n364:                         <button onclick=\"killTree(${t.pid}, '${escapeHtml(t.name)}')\" class=\"px-3 py-1.5 bg-amber-600/20 hover:bg-amber-600/30 text-amber-300 text-xs font-mono rounded border border-amber-500/40 transition\">\n365:                             Kill Tree\n366:                         </button>\n367:                         <button onclick=\"killProcess(${t.pid}, '${escapeHtml(t.name)}')\" class=\"px-4 py-1.5 bg-red-600 hover:bg-red-500 text-white font-bold text-xs font-mono rounded transition flex items-center gap-1.5 shadow-lg shadow-red-900/30\">\n368:                             <i data-lucide=\"zap\" class=\"w-3.5 h-3.5\"></i> KILL\n369:                         </button>\n370:                     </div>\n371:                 </div>\n372:             </div>\n373:         `;\n374:     });\n375: \n376:     container.innerHTML = html;\n377: }\n378: \n379: // Render Remote Desktop & RMM Tab\n380: function renderRMM(rmmList) {\n381:     const container = document.getElementById('rmm-table-body');\n382:     if (!container) return;\n383: \n384:     if (!rmmList || rmmList.length === 0) {\n385:         container.innerHTML = `\n386:             <tr>\n387:                 <td colspan=\"6\" class=\"p-8 text-center text-slate-400 text-sm\">\n388:                     No active Remote Desktop, VNC, RMM, or unauthorized RAT tools running.\n389:                 </td>\n390:             </tr>\n391:         `;\n392:         return;\n393:     }\n394: \n395:     let html = '';\n396:     rmmList.forEach(r => {\n397:         const ports = r.network?.connections?.map(c => `${c.local_port || ''} -> ${c.remote_addr || 'LISTEN'}`).join(', ') || 'No active sockets';\n398:         html += `\n399:             <tr class=\"border-b border-slate-800/60 hover:bg-slate-800/30\">\n400:                 <td class=\"p-3 font-mono font-bold text-cyan-400\">${escapeHtml(r.name)}</td>\n401:                 <td class=\"p-3 font-mono text-xs text-slate-300\">${r.pid}</td>\n402:                 <td class=\"p-3\">\n403:                     <span class=\"px-2 py-0.5 rounded text-[10px] font-mono font-bold badge-rmm\">\n404:                         ${r.primary_category}\n405:                     </span>\n406:                 </td>\n407:                 <td class=\"p-3 font-mono text-xs text-slate-400 truncate max-w-xs\" title=\"${escapeHtml(r.exe)}\">${escapeHtml(r.exe)}</td>\n408:                 <td class=\"p-3 font-mono text-xs text-slate-300\">${escapeHtml(ports)}</td>\n409:                 <td class=\"p-3 text-right\">\n410:                     <button onclick=\"killProcess(${r.pid}, '${escapeHtml(r.name)}')\" class=\"px-3 py-1 bg-red-600/30 hover:bg-red-600 text-red-200 text-xs font-mono rounded border border-red-500/50\">"}
