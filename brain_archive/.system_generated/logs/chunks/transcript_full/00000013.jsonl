                      Trace\n611:                             </button>\n612:                             <button onclick=\"blockIP('${escapeHtml(c.remote_ip)}')\" class=\"px-2 py-1 bg-red-600/20 hover:bg-red-600/30 text-red-300 text-xs rounded border border-red-500/40\" title=\"Block this IP in Firewall\">\n613:                                 Block IP\n614:                             </button>\n615:                         ` : ''}\n616:                         <button onclick=\"killProcess(${c.pid}, '${escapeHtml(c.process_name)}')\" class=\"px-2.5 py-1 bg-red-600 hover:bg-red-500 text-white font-bold text-xs rounded shadow\">\n617:                             Kill\n618:                         </button>\n619:                     </div>\n620:                 </td>\n621:             </tr>\n622:         `;\n623:     });\n624: \n625:     tbody.innerHTML = html;\n626: }\n627: \n628: function setNetFilter(f) {\n629:     state.netFilter = f;\n630:     document.querySelectorAll('.net-filter-btn').forEach(btn => {\n631:         if (btn.dataset.netFilter === f) {\n632:             btn.classList.add('bg-cyan-600', 'text-white');\n633:             btn.classList.remove('bg-slate-800', 'text-slate-400');\n634:         } else {\n635:             btn.classList.remove('bg-cyan-600', 'text-white');\n636:             btn.classList.add('bg-slate-800', 'text-slate-400');\n637:         }\n638:     });\n639:     if (state.lastNetworkData) {\n640:         renderNetworkTable(state.lastNetworkData.connections);"}
