{"step_index":657,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T07:01:02Z","content":"Created At: 2026-11-07T08:01:02+01:00\nCompleted At: 2026-11-07T08:01:02+01:00\nShowing lines 800-860 of 1690\n800: \n801: function closeAddRuleModal() {\n802:     const modal = document.getElementById('add-rule-modal');\n803:     if (modal) modal.classList.add('hidden');\n804: }\n805: \n806: async function handleCreateRule(e) {\n807:     e.preventDefault();\n808:     const action = document.getElementById('rule-action').value;\n809:     const type = document.getElementById('rule-type').value;\n810:     const value = document.getElementById('rule-value').value;\n811:     const comment = document.getElementById('rule-comment').value;\n812: \n813:     const endpoint = action === 'allow' ? '/api/policy/allow' : '/api/policy/block';\n814:     const ruleType = action === 'block_ip' ? 'ip' : type;\n815: \n816:     try {\n817:         const res = await fetch(endpoint, {\n818:             method: 'POST',\n819:             headers: { 'Content-Type': 'application/json' },\n820:             body: JSON.stringify({ type: ruleType, value: value, comment: comment })\n821:         });\n822:         const data = await res.json();\n823:         if (data.success) {\n824:             showToast('Rule Created', data.message, 'success');\n825:             closeAddRuleModal();\n826:             loadPolicyRules();\n827:             runScan(false);\n828:         } else {\n829:             showToast('Failed', data.message, 'danger');\n830:         }\n831:     } catch (err) {\n832:         showToast('Error', 'Failed to create policy rule', 'danger');\n833:     }\n834: }\n835: \n836: async function quickAllowProcess(name, exe) {\n837:     if (!confirm(`Whitelist and trust '${name}'?\\nThis will suppress all threat alerts and exempt it from termination.`)) return;\n838:     try {\n839:         const res = await fetch('/api/policy/allow', {\n840:             method: 'POST',\n841:             headers: { 'Content-Type': 'application/json' },\n842:             body: JSON.stringify({ type: 'name', value: name, comment: `User Whitelisted (${exe || 'Process'})` })\n843:         });\n844:         const data = await res.json();\n845:         if (data.success) {\n846:             showToast('Whitelisted', `Added '${name}' to allowed software policy.`, 'success');\n847:             runScan(true);\n848:         }\n849:     } catch (e) {\n850:         showToast('Error', 'Failed to allow process', 'danger');\n851:     }\n852: }\n853: \n854: async function quickBlockProcess(name, exe) {\n855:     if (!confirm(`Blacklist and ban '${name}'?\\nThis will mark it as a Critical threat and ban it by policy.`)) return;\n856:     try {\n857:         const res = await fetch('/api/policy/block', {\n858:             method: 'POST',\n859:             headers: { 'Content-Type': 'application/json' },\n860:             body: JSON.stringify({ type: 'name', value: name, comment: `User Blacklisted (${exe || 'Process'})` })"}
