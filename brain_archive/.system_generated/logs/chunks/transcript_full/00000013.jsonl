-slate-400 hover:text-white flex items-center gap-1.5 transition\">\n                        <i data-lucide=\"history\" class=\"w-3.5 h-3.5 text-cyan-400\"></i> Blocked & Eradicated History (<span id=\"sub-blocked-count\">0</span>)\n                    </button>\n                </div>\n            </div>\n\n            <!-- Active Threats Grid Container -->\n            <div id=\"threats-grid\" class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                <!-- Rendered dynamically by JavaScript -->\n            </div>\n\n            <!-- Previously Blocked & Eradicated History Table (Full Tracking List) -->\n            <div id=\"threats-history-view\" class=\"cyber-card overflow-hidden hidden space-y-3 p-4\">\n                <div class=\"border-b border-slate-800 pb-3 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2\">\n                    <div>\n                        <h3 class=\"font-mono text-sm font-bold text-red-400 flex items-center gap-2\">\n                            <i data-lucide=\"shield-ban\" class=\"w-4 h-4\"></i> PREVIOUSLY BLOCKED, TERMINATED & QUARANTINED THREATS\n                        </h3>\n                        <p class=\"text-xs text-slate-400 mt-0.5\">Immutable audit tracking of all eradicated malware, killed trojans, and enforced blocklist actions.</p>\n                    </div>\n                    <button onclick=\"loadBlockedHistory()\" class=\"px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyan-400 text-xs font-mono border border-slate-700 flex items-center gap-1.5 transition\">\n                        <i data-lucide=\"refresh-cw\" class=\"w-3.5 h-3.5\"></i> Refresh Tracking\n                    </button>\n                </div>\n\n                <div class=\"overflow-x-auto max-h-[500px] overflow-y-auto\">\n                    <table class=\"w-full text-left text-xs font-mono\">\n                        <thead class=\"bg-slate-900/90 border-b border-slate-800 text-slate-400 sticky top-0 z-10\">\n                            <tr>\n                                <th class=\"p-3 w-44\">Date & Time</th>\n                                <th class=\"p-3 w-36\">Action Taken</th>\n                                <th class=\"p-3\">Target / Binary Name</th>\n                                <th class=\"p-3 w-24\">PID</th>\n                                <th class=\"p-3\">Details & Eradication Method</th>\n                                <th class=\"p-3 w-28 text-right\">Result</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"blocked-history-table-body\">\n                            <!-- Populated dynamically -->\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </section>","Target":"        <!-- ========================================== -->\n        <!-- TAB 1: ACTIVE THREATS & REMEDIATION -->\n        <!-- ========================================== -->\n        <section id=\"view-threats\" class=\"tab-content space-y-4\">\n            <div class=\"flex items-center justify-between\">\n                <div>\n                    <h2 class=\"text-base font-bold font-mono text-white\">Active Threat Vectors</h2>\n                    <p class=\"text-xs text-slate-400\">Processes exceeding risk thresholds via signatures, LOLRMM, masquerading, policy violations, or injected APIs.</p>\n                </div>\n                <div class=\"text-xs text-slate-400 font-mono\">\n                    Showing real-time detections with direct kill, allow, and block controls\n                </div>\n            </div>\n\n            <!-- Threats Grid Container -->\n            <div id=\"threats-grid\" class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                <!-- Rendered dynamically by JavaScript -->\n            </div>\n        </section>"}}]}
