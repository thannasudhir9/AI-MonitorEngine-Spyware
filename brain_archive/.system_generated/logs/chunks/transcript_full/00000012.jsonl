{"step_index":604,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:57:21Z","content":"Created At: 2026-11-07T07:57:21+01:00\nCompleted At: 2026-11-07T07:57:21+01:00\nShowing lines 1-100 of 269\n1: \"\"\"\n2: AegisShield - Remediation & Eradication Engine\n3: Safe process termination, recursive tree killing, threat quarantine,\n4: and immutable incident audit logging.\n5: \"\"\"\n6: \n7: import os\n8: import time\n9: import json\n10: import shutil\n11: import psutil\n12: from datetime import datetime\n13: from pathlib import Path\n14: from typing import Dict, List, Any, Optional\n15: \n16: from .config import LOGS_DIR, QUARANTINE_DIR, CRITICAL_SYSTEM_PROCESSES, SCORE_MEDIUM\n17: from .pe_analyzer import get_file_hashes\n18: \n19: AUDIT_LOG_FILE = LOGS_DIR / \"audit_events.json\"\n20: \n21: \n22: class ThreatRemediator:\n23:     \"\"\"Handles eradication of malicious processes, tree pruning, quarantine, and logs.\"\"\"\n24: \n25:     def __init__(self):\n26:         self._audit_log: List[Dict[str, Any]] = self._load_audit_log()\n27: \n28:     def _load_audit_log(self) -> List[Dict[str, Any]]:\n29:         \"\"\"Load persistent incident log from disk.\"\"\"\n30:         if AUDIT_LOG_FILE.exists():\n31:             try:\n32:                 with open(AUDIT_LOG_FILE, \"r\", encoding=\"utf-8\") as f:\n33:                     return json.load(f)\n34:             except Exception:\n35:                 return []\n36:         return []\n37: \n38:     def _save_audit_log(self):\n39:         \"\"\"Persist audit log to disk.\"\"\"\n40:         try:\n41:             with open(AUDIT_LOG_FILE, \"w\", encoding=\"utf-8\") as f:\n42:                 json.dump(self._audit_log[-500:], f, indent=2)  # Retain latest 500 events\n43:         except Exception:\n44:             pass\n45: \n46:     def log_event(self, action: str, target: str, pid: Optional[int], details: str, status: str = \"SUCCESS\"):\n47:         \"\"\"Record an incident or remediation event.\"\"\"\n48:         event = {\n49:             \"id\": f\"evt_{int(time.time() * 1000)}\",\n50:             \"timestamp\": datetime.now().isoformat(),\n51:             \"time_display\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n52:             \"action\": action,\n53:             \"target\": target,\n54:             \"pid\": pid,\n55:             \"details\": details,\n56:             \"status\": status\n57:         }\n58:         self._audit_log.insert(0, event)\n59:         if len(self._audit_log) > 500:\n60:             self._audit_log = self._audit_log[:500]\n61:         self._save_audit_log()\n62:         return event\n63: \n64:     def get_audit_log(self, limit: int = 100) -> List[Dict[str, Any]]:\n65:         \"\"\"Retrieve recent audit events.\"\"\"\n66:         return self._audit_log[:limit]\n67: \n68:     def is_protected(self, proc: psutil.Process) -> bool:\n69:         \"\"\"Check if process is a protected Windows core binary.\"\"\"\n70:         try:\n71:             name = (proc.name() or \"\").lower()\n72:             if name in CRITICAL_SYSTEM_PROCESSES:\n73:                 sys_rule = CRITICAL_SYSTEM_PROCESSES[name]\n74:                 if not sys_rule.get(\"allow_kill\", True):\n75:                     # Check if running from legitimate System32\n76:                     expected = sys_rule.get(\"expected_path\")\n77:                     try:\n78:                         exe = (proc.exe() or \"\").lower()\n79:                         if not expected or exe.startswith(expected):\n80:                             return True\n81:                     except Exception:\n82:                         return True\n83:         except (psutil.NoSuchProcess, psutil.AccessDenied):\n84:             pass\n85:         return False\n86: \n87:     def kill_process(self, pid: int, force: bool = True, reason: str = \"Manual Eradication\") -> Dict[str, Any]:\n88:         \"\"\"\n89:         Safely terminate a single process by PID.\n90:         \"\"\"\n91:         t