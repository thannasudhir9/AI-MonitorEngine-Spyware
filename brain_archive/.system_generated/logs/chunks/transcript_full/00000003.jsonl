{"step_index":128,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-07T06:08:23Z","input_tokens":3413,"cache_read_tokens":107085,"output_tokens":3994,"thinking":"Building `network_tracer.py` requires enumerating network connections and associated process details. It will leverage a library to gather connection information including local and remote addresses/ports, protocol, and state. Then, a reverse DNS lookup will be performed on the remote IP addresses.\n\n\nLocal caching of geolocation and organization details will enhance performance and enable offline functionality. Assessing the genuineness and reputation of connections requires classifying endpoints based on provider, known suspicious ports, and anonymization services. Aggregated statistics will provide an overview of network activity, categorizing connections as genuine, private, suspicious, or unverified.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\nAegisShield - Network Intelligence, Process Network Auditor & Origin Tracer\nEnumerates all processes using network sockets, traces remote IP origin,\nperforms reverse DNS lookups, and evaluates genuineness and threat reputation.\n\"\"\"\n\nimport os\nimport json\nimport socket\nimport psutil\nfrom pathlib import Path\nfrom typing import Dict, List, Any, Optional\n\nfrom .config import DATABASE_DIR, RMM_PORTS\n\nGEO_CACHE_FILE = DATABASE_DIR / \"geo_cache.json\"\n\n# Major Verified Tech Providers (CIDR prefixes / ASN / Domains)\nVERIFIED_PROVIDERS = [\n    {\"name\": \"Microsoft / Azure\", \"domain_keywords\": [\"microsoft\", \"azure\", \"live.com\", \"office\", \"msn.com\", \"bing\", \"windowsupdate\"], \"badge\": \"GENUINE CLOUD / CDN\"},\n    {\"name\": \"Google / GCP\", \"domain_keywords\": [\"google\", \"1e100.net\", \"gstatic\", \"youtube\", \"googleapis\"], \"badge\": \"GENUINE CLOUD / CDN\"},\n    {\"name\": \"Cloudflare\", \"domain_keywords\": [\"cloudflare\", \"cloudflarenet\"], \"badge\": \"GENUINE CLOUD / CDN\"},\n    {\"name\": \"Amazon AWS\", \"domain_keywords\": [\"amazon\", \"aws\", \"compute.amazonaws\", \"cloudfront\"], \"badge\": \"GENUINE CLOUD / CDN\"},\n    {\"name\": \"Apple\", \"domain_keywords\": [\"apple.com\", \"icloud.com\", \"apple-dns\"], \"badge\": \"GENUINE CLOUD / CDN\"},\n    {\"name\": \"Akamai\", \"domain_keywords\": [\"akamai\", \"akamaitechnologies\"], \"badge\": \"GENUINE CLOUD / CDN\"},\n    {\"name\": \"GitHub\", \"domain_keywords\": [\"github.com\", \"githubusercontent\"], \"badge\": \"GENUINE CLOUD / CDN\"},\n    {\"name\": \"Fastly\", \"domain_keywords\": [\"fastly\", \"fastlylb\"], \"badge\": \"GENUINE CLOUD / CDN\"}\n]\n\n# Suspicious / Malicious indicators\nSUSPICIOUS_PORTS = {\n    1177: \"njRAT Default C2\",\n    1604: \"DarkComet RAT Default C2\",\n    2404: \"Remcos RAT Default C2\",\n    4444: \"Metasploit / Reverse Shell Port\",\n    4782: \"QuasarRAT Default C2\",\n    5555: \"Android ADB / Trojan Backdoor\",\n    6606: \"AsyncRAT Default C2\",\n    7707: \"AsyncRAT Alternate C2\",\n    8808: \"AsyncRAT Alternate C2\",\n    3333: \"Crypto Mining Stratum Pool\",\n    7777: \"Trojan Miner Pool\",\n    9999: \"Trojan Miner Pool\",\n    6667: \"IRC Botnet Standard Port\"\n}\n\n\nclass NetworkTracer:\n    \"\"\"Audits processes using the network and evaluates IP genuineness.\"\"\"\n\n    def __init__(self):\n        self._geo_cache: Dict[str, Dict[str, Any]] = self._load_cache()\n\n    def _load_cache(self) -> Dict[str, Dict[str, Any]]:\n        \"\"\"Load cached IP lookup records from disk.\"\"\"\n        if GEO_CACHE_FILE.exists():\n            try:\n                with open(GEO_CACHE_FILE, \"r\", encoding=\"utf-8\") as f:\n                    return json.load(f)\n            except Exception:\n                return {}\n        return {}\n\n    def _save_cache(self):\n        \"\"\"Save cache to disk.\"\"\"\n        try:\n            with open(GEO_CACHE_FILE, \"w\", encoding=\"utf-8\") as f:\n                json.dump(self._geo_cache, f, indent=2)\n        except Exception:\n            pass\n\n    def is_private_ip(self, ip: str) -> bool:\n        \"\"\"Check if IP address is localhost or in private RFC 1918 range.\"\"\"\n        if not ip:\n            return True\n        if ip in (\"127.0.0.1\", \"::1\", \"0.0.0.0\", \"::\"):\n            return True\n        parts = ip.split(\".\")\n        if len(parts) == 4:\n            try:\n                p0, p1 = int(parts[0]), int(parts[1])\n                if p0 == 10:\n                    return True\n                if p0 == 172 and 16 <= p1 <= 31:\n                    return True\n                if p0 == 192 and p1 == 168:\n                    return True\n                if p0 == 169 and p1 == 254:\n                    return True  # APIPA\n            except ValueError:\n                pass\n        return False\n\n    def resolve_reverse_dns(self, ip: str) -> str:\n        \"\"\"Resolve PTR record to domain name with timeout.\"\"\"\n        if not ip or self.is_private_ip(ip):\n            return \"Local / Loopback\"\n\n        if ip in self._geo_cache and \"hostname\" in self._geo_cache[ip]:\n            return self._geo_cache[ip][\"hostname\"]\n\n        try:\n            socket.setdefaulttimeout(0.7)\n            hostname, _, _ = socket.gethostbyaddr(ip)\n            return hostname\n        except Exception:\n            return \"Unresolved Host\"\n\n    def trace_ip(self, ip: str) -> Dict[str, Any]:\n        \"\"\"\n        Deep trace remote IP: reverse DNS, organization, country, and genuineness assessment.\n        \"\"\"\n        if not ip:\n            return {\"ip\": \"\", \"verdict\": \"UNKNOWN\", \"is_genuine\": False}\n\n        if self.is_private_ip(ip):\n            return {\n                \"ip\": ip,\n                \"hostname\": \"Local Host / Gateway\",\n                \"country\": \"Local Network\",\n                \"country_code\": \"LAN\",\n                \"org\": \"Private Subnet (RFC 1918)\",\n                \"verdict\": \"PRIVATE LAN\",\n                \"is_genuine\": True,\n                \"is_private\": True,\n                \"confidence\": 100\n            }\n\n        # Check cache\n        if ip in self._geo_cache:\n            return self._geo_cache[ip]\n\n        hostname = self.resolve_reverse_dns(ip)\n        lower_host = hostname.lower()\n\n        # Classify against verified global tech providers\n        detected_org = \"External Host / ISP\"\n        verdict = \"UNVERIFIED EXTERNAL\"\n        is_genuine = False\n        confidence = 60\n\n        for prov in VERIFIED_PROVIDERS:\n            for kw in prov[\"domain_keywords\"]:\n                if kw in lower_host:\n                    detected_org = prov[\"name\"]\n                    verdict = prov[\"badge\"]\n                    is_genuine = True\n                    confidence = 95\n                    break\n            if is_genuine:\n                break\n\n        # Check common public DNS resolvers\n        if ip in (\"8.8.8.8\", \"8.8.4.4\"):\n            detected_org = \"Google Public DNS\"\n            verdict = \"GENUINE CLOUD / CDN\"\n            is_genuine = True\n        elif ip in (\"1.1.1.1\", \"1.0.0.1\"):\n            detected_org = \"Cloudflare DNS\"\n            verdict = \"GENUINE CLOUD / CDN\"\n            is_genuine = True\n        elif ip in (\"9.9.9.9\", \"149.112.112.112\"):\n            detected_org = \"Quad9 Secure DNS\"\n            verdict = \"GENUINE CLOUD / CDN\"\n            is_genuine = True\n\n        result = {\n            \"ip\": ip,\n            \"hostname\": hostname,\n            \"country\": \"Global Internet\",\n            \"country_code\": \"NET\",\n            \"org\": detected_org,\n            \"verdict\": verdict,\n            \"is_genuine\": is_genuine,\n            \"is_private\": False,\n            \"confidence\": confidence\n        }\n\n        # Cache lookup\n        if len(self._geo_cache) > 500:\n            self._geo_cache.clear()\n        self._geo_cache[ip] = result\n        self._save_cache()\n\n        return result\n\n    def audit_all_network_processes(self) -> Dict[str, Any]:\n        \"\"\"\n        Scan every active network socket, map to owning process,\n        trace origin, and evaluate threat and genuineness.\n        \"\"\"\n        connections_list = []\n        processes_using_network = set()\n        listening_sockets = 0\n        established_sockets = 0\n        external_sockets = 0\n        suspicious_sockets = 0\n        genuine_cdn_sockets = 0\n\n        # Build PID metadata cache\n        proc_cache: Dict[int, Dict[str, Any]] = {}\n        for p in psutil.process_iter([\"pid\", \"name\", \"exe\", \"username\", \"cpu_percent\", \"memory_info\"]):\n            try:\n                mem_mb = round(p.info[\"memory_info\"].rss / (1024 * 1024), 1) if p.info.get(\"memory_info\") else 0.0\n                proc_cache[p.info[\"pid\"]] = {\n                    \"name\": p.info.get(\"name\") or \"Unknown\",\n                    \"exe\": p.info.get(\"exe\") or \"Protected/System\",\n                    \"username\": p.info.get(\"username\") or \"System\",\n                    \"cpu_percent\": p.info.get(\"cpu_percent\") or 0.0,\n                    \"memory_mb\": mem_mb\n                }\n            except (psutil.NoSuchProcess, psutil.AccessDenied):\n                continue\n\n        # Enumerate sockets\n        try:\n            raw_conns = psutil.net_connections(kind=\"inet\")\n        except Exception:\n            raw_conns = []\n\n        for conn in raw_conns:\n            pid = conn.pid\n            if not pid or pid not in proc_cache:\n                continue\n\n            processes_using_network.add(pid)\n            p_info = proc_cache[pid]\n\n            local_addr = f\"{conn.laddr.ip}:{conn.laddr.port}\" if conn.laddr else \"\"\n            local_port = conn.laddr.port if conn.laddr else 0\n            remote_ip = conn.raddr.ip if conn.raddr else \"\"\n            remote_port = conn.raddr.port if conn.raddr else 0\n            remote_addr = f\"{remote_ip}:{remote_port}\" if conn.raddr else \"LISTEN\"\n            status = conn.status\n\n            if status == \"LISTEN\":\n                listening_sockets += 1\n            elif status == \"ESTABLISHED\":\n                established_sockets += 1\n\n            is_private = self.is_private_ip(remote_ip)\n            if not is_private and remote_ip:\n                external_sockets += 1\n\n            # Check Suspicious / RMM ports\n            is_suspicious_port = remote_port in SUSPICIOUS_PORTS or local_port in SUSPICIOUS_PORTS\n            is_rmm_port = remote_port in RMM_PORTS or local_port in RMM_PORTS\n            threat_note = \"\"\n\n            if is_suspicious_port:\n                suspicious_sockets += 1\n                threat_note = SUSPICIOUS_PORTS.get(remote_port) or SUSPICIOUS_PORTS.get(local_port)\n            elif is_rmm_port:\n                threat_note = RMM_PORTS.get(remote_port) or RMM_PORTS.get(local_port)\n\n            # Trace IP Origin & Genuineness\n            ip_trace = self.trace_ip(remote_ip) if remote_ip else {\n                \"ip\": \"\", \"hostname\": \"N/A\", \"org\": \"Listening Daemon\", \"country\": \"Local\", \"verdict\": \"LISTENING PORT\", \"is_genuine\": True\n            }\n\n            # If suspicious port, override verdict\n            if is_suspicious_port:\n                ip_trace[\"verdict\"] = \"SUSPICIOUS C2 / RAT PORT\"\n                ip_trace[\"is_genuine\"] = False\n\n            if ip_trace[\"verdict\"] == \"GENUINE CLOUD / CDN\":\n                genuine_cdn_sockets += 1\n\n            connections_list.append({\n                \"pid\": pid,\n                \"process_name\": p_info[\"name\"],\n                \"exe_path\": p_info[\"exe\"],\n                \"username\": p_info[\"username\"],\n                \"protocol\": \"TCP\" if conn.type == 1 else \"UDP\",\n                \"local_addr\": local_addr,\n                \"local_port\": local_port,\n                \"remote_addr\": remote_addr,\n                \"remote_ip\": remote_ip,\n                \"remote_port\": remote_port,\n                \"status\": status,\n                \"is_private\": is_private,\n                \"is_suspicious\": is_suspicious_port,\n                \"is_rmm\": is_rmm_port,\n                \"threat_note\": threat_note,\n                \"trace\": ip_trace\n            })\n\n        # Sort: Suspicious first, then established external\n        connections_list.sort(key=lambda x: (x[\"is_suspicious\"], not x[\"is_private\"], x[\"status\"] == \"ESTABLISHED\"), reverse=True)\n\n        return {\n            \"total_network_processes\": len(processes_using_network),\n            \"total_active_sockets\": len(connections_list),\n            \"listening_sockets\": listening_sockets,\n            \"established_sockets\": established_sockets,\n            \"external_sockets\": external_sockets,\n            \"suspicious_sockets\": suspicious_sockets,\n            \"genuine_cdn_sockets\": genuine_cdn_sockets,\n            \"connections\": connections_list\n        }\n","Overwrite":true,"Path":"c:\\Users\\thann\\Downloads\\AntiGravity\\SpywareProcessMon\\backend\\network_tracer.py"}}]}
{"step_index":129,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:08:50Z","content":"Created At: 2026-11-07T07:08:50+01:00\nCompleted At: 2026-11-07T07:08:50+01:00\nCreated file."}
{"step_index":130,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-07T06:08:50Z","input_tokens":4058,"cache_read_tokens":110510,"output_tokens":5275,"thinking":"Initial focus is on the `email_notifier.py` script. The script's role involves managing and storing SMTP settings within a configuration file. Key settings include server address, port, TLS usage, sender and recipient emails, a password, and a flag for automatic email sending upon critical events.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\nAegisShield - Email Incident & Security Posture Notifier\nConfigurable SMTP dispatcher that generates and sends rich HTML security reports,\ncritical threat alerts, and network telemetry audits.\n\"\"\"\n\nimport os\nimport json\nimport smtplib\nfrom email.mime.text import MIMEText\nfrom email.mime.multipart import MIMEMultipart\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Dict, List, Any, Optional\n\nfrom .config import DATABASE_DIR\n\nEMAIL_CONFIG_FILE = DATABASE_DIR / \"email_config.json\"\n\n\nclass EmailNotifier:\n    \"\"\"Handles SMTP configuration, HTML report formatting, and email dispatch.\"\"\"\n\n    def __init__(self):\n        self._config = self._load_config()\n\n    def _load_config(self) -> Dict[str, Any]:\n        \"\"\"Load SMTP settings from disk.\"\"\"\n        default_config = {\n            \"smtp_server\": \"smtp.gmail.com\",\n            \"smtp_port\": 587,\n            \"use_tls\": True,\n            \"sender_email\": \"\",\n            \"sender_password\": \"\",\n            \"recipient_email\": \"\",\n            \"auto_email_on_critical\": False,\n            \"last_sent\": None\n        }\n\n        if EMAIL_CONFIG_FILE.exists():\n            try:\n                with open(EMAIL_CONFIG_FILE, \"r\", encoding=\"utf-8\") as f:\n                    data = json.load(f)\n                    for k in default_config:\n                        if k not in data:\n                            data[k] = default_config[k]\n                    return data\n            except Exception:\n                return default_config\n        return default_config\n\n    def _save_config(self):\n        \"\"\"Persist SMTP configuration to disk.\"\"\"\n        try:\n            with open(EMAIL_CONFIG_FILE, \"w\", encoding=\"utf-8\") as f:\n                json.dump(self._config, f, indent=2)\n        except Exception:\n            pass\n\n    def get_config(self, mask_password: bool = True) -> Dict[str, Any]:\n        \"\"\"Retrieve current configuration.\"\"\"\n        cfg = dict(self._config)\n        if mask_password and cfg.get(\"sender_password\"):\n            cfg[\"sender_password\"] = \"••••••••••••\"\n        return cfg\n\n    def update_config(self, new_settings: Dict[str, Any]) -> Dict[str, Any]:\n        \"\"\"Update SMTP settings.\"\"\"\n        for key in [\"smtp_server\", \"smtp_port\", \"use_tls\", \"sender_email\", \"recipient_email\", \"auto_email_on_critical\"]:\n            if key in new_settings:\n                self._config[key] = new_settings[key]\n\n        # Only update password if a non-masked value is provided\n        pw = new_settings.get(\"sender_password\", \"\")\n        if pw and not pw.startswith(\"••\"):\n            self._config[\"sender_password\"] = pw\n\n        self._save_config()\n        return {\"success\": True, \"message\": \"Email settings saved successfully.\"}\n\n    def generate_html_report(self, report_data: Dict[str, Any]) -> str:\n        \"\"\"\n        Generate a modern, cybersecurity executive HTML report with tables\n        for threats, remote desktop sessions, network processes, and audit actions.\n        \"\"\"\n        scan_time = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n        threats = report_data.get(\"threats\", [])\n        rmm_tools = report_data.get(\"rmm_tools\", [])\n        network = report_data.get(\"network\", {})\n        total_procs = report_data.get(\"total_processes\", 0)\n        health_index = report_data.get(\"system_health_index\", 100)\n        audit_log = report_data.get(\"audit_log\", [])\n\n        # Color-coded status header\n        if len(threats) > 0:\n            status_color = \"#ef4444\"\n            status_badge = \"CRITICAL THREATS DETECTED\"\n        else:\n            status_color = \"#10b981\"\n            status_badge = \"SYSTEM HEALTH SECURE\"\n\n        # Build Threat Rows\n        threat_rows = \"\"\n        if threats:\n            for t in threats:\n                reasons_text = \"<br>\".join([f\"• <b>{r.get('vector')}</b>: {r.get('detail')}\" for r in t.get(\"reasons\", [])])\n                threat_rows += f\"\"\"\n                <tr style=\"border-bottom: 1px solid #1e293b;\">\n                    <td style=\"padding: 10px; font-weight: bold; color: #f8fafc;\">{t.get('name')} (PID: {t.get('pid')})</td>\n                    <td style=\"padding: 10px; color: #ef4444; font-weight: bold;\">{t.get('primary_category')}</td>\n                    <td style=\"padding: 10px; font-weight: bold; color: #f59e0b;\">{t.get('threat_score')}/100</td>\n                    <td style=\"padding: 10px; font-size: 11px; color: #94a3b8; word-break: break-all;\">{t.get('exe')}</td>\n                    <td style=\"padding: 10px; font-size: 11px; color: #cbd5e1;\">{reasons_text}</td>\n                </tr>\n                \"\"\"\n        else:\n            threat_rows = \"\"\"<tr><td colspan=\"5\" style=\"padding: 15px; text-align: center; color: #10b981;\">No active threats detected. All running processes passed heuristics.</td></tr>\"\"\"\n\n        # Build RMM / Remote Desktop Rows\n        rmm_rows = \"\"\n        if rmm_tools:\n            for r in rmm_tools:\n                ports = \", \".join([f\"{c.get('local_port')} -> {c.get('remote_addr')}\" for c in r.get(\"network\", {}).get(\"connections\", [])]) or \"No active sockets\"\n                rmm_rows += f\"\"\"\n                <tr style=\"border-bottom: 1px solid #1e293b;\">\n                    <td style=\"padding: 8px; color: #06b6d4; font-weight: bold;\">{r.get('name')} (PID: {r.get('pid')})</td>\n                    <td style=\"padding: 8px; color: #94a3b8;\">{r.get('primary_category')}</td>\n                    <td style=\"padding: 8px; font-size: 11px; color: #cbd5e1;\">{r.get('exe')}</td>\n                    <td style=\"padding: 8px; font-size: 11px; color: #fde68a;\">{ports}</td>\n                </tr>\n                \"\"\"\n        else:\n            rmm_rows = \"\"\"<tr><td colspan=\"4\" style=\"padding: 12px; text-align: center; color: #94a3b8;\">No active Remote Desktop or RMM sessions detected.</td></tr>\"\"\"\n\n        # Build Network Overview Rows\n        net_rows = \"\"\n        connections = network.get(\"connections\", [])[:15]  # Top 15 connections\n        if connections:\n            for c in connections:\n                verdict_color = \"#10b981\" if c.get(\"trace\", {}).get(\"is_genuine\") else (\"#ef4444\" if c.get(\"is_suspicious\") else \"#94a3b8\")\n                net_rows += f\"\"\"\n                <tr style=\"border-bottom: 1px solid #1e293b;\">\n                    <td style=\"padding: 8px; color: #f8fafc;\">{c.get('process_name')} ({c.get('pid')})</td>\n                    <td style=\"padding: 8px; font-family: monospace; color: #cbd5e1;\">{c.get('local_addr')}</td>\n                    <td style=\"padding: 8px; font-family: monospace; color: #06b6d4;\">{c.get('remote_addr')}</td>\n                    <td style=\"padding: 8px; font-size: 11px; color: #94a3b8;\">{c.get('trace', {}).get('hostname')} ({c.get('trace', {}).get('org')})</td>\n                    <td style=\"padding: 8px; font-weight: bold; color: {verdict_color}; font-size: 11px;\">{c.get('trace', {}).get('verdict')}</td>\n                </tr>\n                \"\"\"\n        else:\n            net_rows = \"\"\"<tr><td colspan=\"5\" style=\"padding: 12px; text-align: center; color: #94a3b8;\">No active sockets recorded.</td></tr>\"\"\"\n\n        html = f\"\"\"\n        <!DOCTYPE html>\n        <html>\n        <head>\n            <meta charset=\"utf-8\">\n            <title>AegisShield EDR Security Report</title>\n        </head>\n        <body style=\"margin: 0; padding: 20px; background-color: #080c14; font-family: 'Segoe UI', Arial, sans-serif; color: #f8fafc;\">\n            <div style=\"max-width: 900px; margin: 0 auto; background: #0f172a; border: 1px solid #1e293b; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.5);\">\n                \n                <!-- Header Banner -->\n                <div style=\"background: linear-gradient(135deg, #0b1329 0%, #172554 100%); padding: 24px; border-bottom: 2px solid #06b6d4;\">\n                    <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n                        <div>\n                            <h1 style=\"margin: 0; font-size: 24px; letter-spacing: 1px; color: #ffffff;\">AEGIS<span style=\"color: #06b6d4;\">SHIELD</span> EDR</h1>\n                            <p style=\"margin: 4px 0 0 0; font-size: 12px; color: #94a3b8;\">Executive Endpoint Threat & Process Intelligence Report</p>\n                        </div>\n                        <div style=\"text-align: right;\">\n                            <span style=\"display: inline-block; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: bold; background-color: {status_color}22; color: {status_color}; border: 1px solid {status_color};\">\n                                {status_badge}\n                            </span>\n                            <div style=\"font-size: 11px; color: #94a3b8; margin-top: 5px;\">Report Time: {scan_time}</div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Metrics Dashboard Grid -->\n                <div style=\"display: table; width: 100%; border-bottom: 1px solid #1e293b; background: #111a2e;\">\n                    <div style=\"display: table-row;\">\n                        <div style=\"display: table-cell; padding: 16px; border-right: 1px solid #1e293b; text-align: center;\">\n                            <div style=\"font-size: 11px; color: #94a3b8; text-transform: uppercase;\">Active Processes</div>\n                            <div style=\"font-size: 22px; font-weight: bold; color: #ffffff; margin-top: 4px;\">{total_procs}</div>\n                        </div>\n                        <div style=\"display: table-cell; padding: 16px; border-right: 1px solid #1e293b; text-align: center;\">\n                            <div style=\"font-size: 11px; color: #94a3b8; text-transform: uppercase;\">Detected Threats</div>\n                            <div style=\"font-size: 22px; font-weight: bold; color: #ef4444; margin-top: 4px;\">{len(threats)}</div>\n                        </div>\n                        <div style=\"display: table-cell; padding: 16px; border-right: 1px solid #1e293b; text-align: center;\">\n                            <div style=\"font-size: 11px; color: #94a3b8; text-transform: uppercase;\">Remote Desktop / RMM</div>\n                            <div style=\"font-size: 22px; font-weight: bold; color: #06b6d4; margin-top: 4px;\">{len(rmm_tools)}</div>\n                        </div>\n                        <div style=\"display: table-cell; padding: 16px; text-align: center;\">\n                            <div style=\"font-size: 11px; color: #94a3b8; text-transform: uppercase;\">Health Index</div>\n                            <div style=\"font-size: 22px; font-weight: bold; color: #10b981; margin-top: 4px;\">{health_index}%</div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Section: Detected Threats -->\n                <div style=\"padding: 24px;\">\n                    <h2 style=\"margin: 0 0 12px 0; font-size: 16px; color: #f8fafc; border-bottom: 1px solid #1e293b; padding-bottom: 8px;\">\n                        🚨 Active Process Threats & Malware Anomaly Detection\n                    </h2>\n                    <table style=\"width: 100%; border-collapse: collapse; font-size: 12px; text-align: left;\">\n                        <thead>\n                            <tr style=\"background: #1e293b; color: #94a3b8;\">\n                                <th style=\"padding: 8px;\">Process / PID</th>\n                                <th style=\"padding: 8px;\">Category</th>\n                                <th style=\"padding: 8px;\">Risk Score</th>\n                                <th style=\"padding: 8px;\">Executable Path</th>\n                                <th style=\"padding: 8px;\">Triggered Heuristics</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            {threat_rows}\n                        </tbody>\n                    </table>\n                </div>\n\n                <!-- Section: Remote Desktop / RMM -->\n                <div style=\"padding: 0 24px 24px 24px;\">\n                    <h2 style=\"margin: 0 0 12px 0; font-size: 16px; color: #06b6d4; border-bottom: 1px solid #1e293b; padding-bottom: 8px;\">\n                        📡 Remote Desktop & RMM Software Monitor (LOLRMM)\n                    </h2>\n                    <table style=\"width: 100%; border-collapse: collapse; font-size: 12px; text-align: left;\">\n                        <thead>\n                            <tr style=\"background: #1e293b; color: #94a3b8;\">\n                                <th style=\"padding: 8px;\">Software / PID</th>\n                                <th style=\"padding: 8px;\">Category</th>\n                                <th style=\"padding: 8px;\">Path</th>\n                                <th style=\"padding: 8px;\">Sockets / Ports</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            {rmm_rows}\n                        </tbody>\n                    </table>\n                </div>\n\n                <!-- Section: Network Process Audit & Origin Tracer -->\n                <div style=\"padding: 0 24px 24px 24px;\">\n                    <h2 style=\"margin: 0 0 12px 0; font-size: 16px; color: #10b981; border-bottom: 1px solid #1e293b; padding-bottom: 8px;\">\n                        🌐 Network Process Audit & Remote IP Origin Tracer\n                    </h2>\n                    <table style=\"width: 100%; border-collapse: collapse; font-size: 12px; text-align: left;\">\n                        <thead>\n                            <tr style=\"background: #1e293b; color: #94a3b8;\">\n                                <th style=\"padding: 8px;\">Process (PID)</th>\n                                <th style=\"padding: 8px;\">Local Socket</th>\n                                <th style=\"padding: 8px;\">Remote Socket</th>\n                                <th style=\"padding: 8px;\">Reverse DNS / ISP</th>\n                                <th style=\"padding: 8px;\">Genuineness Verdict</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            {net_rows}\n                        </tbody>\n                    </table>\n                </div>\n\n                <!-- Footer -->\n                <div style=\"background: #0b111e; padding: 16px; text-align: center; font-size: 11px; color: #64748b; border-top: 1px solid #1e293b;\">\n                    Report generated by AegisShield Endpoint Threat Detection & Eradication System. Keep this record for compliance and SOC auditing.\n                </div>\n            </div>\n        </body>\n        </html>\n        \"\"\"\n        return html\n\n    def send_email(self, subject: str, html_content: str, recipient: Optional[str] = None) -> Dict[str, Any]:\n        \"\"\"Dispatch email using configured SMTP settings.\"\"\"\n        cfg = self._config\n        server_host = cfg.get(\"smtp_server\")\n        server_port = int(cfg.get(\"smtp_port\", 587))\n        sender = cfg.get(\"sender_email\")\n        password = cfg.get(\"sender_password\")\n        to_email = recipient or cfg.get(\"recipient_email\")\n\n        if not server_host or not sender or not to_email:\n            return {\n                \"success\": False,\n                \"message\": \"Incomplete SMTP configuration. Please configure SMTP Server, Sender Email, and Recipient in Settings.\"\n            }\n\n        try:\n            msg = MIMEMultipart(\"alternative\")\n            msg[\"Subject\"] = subject\n            msg[\"From\"] = f\"AegisShield EDR <{sender}>\"\n            msg[\"To\"] = to_email\n\n            # Attach HTML body\n            msg.attach(MIMEText(html_content, \"html\"))\n\n            # Dispatch via SMTP\n            if server_port == 465:\n                # SSL\n                server = smtplib.SMTP_SSL(server_host, server_port, timeout=10)\n            else:\n                # STARTTLS\n                server = smtplib.SMTP(server_host, server_port, timeout=10)\n                if cfg.get(\"use_tls\", True):\n                    server.starttls()\n\n            if password:\n                server.login(sender, password)\n\n            server.sendmail(sender, [to_email], msg.as_string())\n            server.quit()\n\n            self._config[\"last_sent\"] = datetime.now().isoformat()\n            self._save_config()\n\n            return {\n                \"success\": True,\n                \"message\": f\"Security report successfully dispatched to {to_email}.\"\n            }\n\n        except smtplib.SMTPAuthenticationError:\n            return {\n                \"success\": False,\n                \"message\": \"SMTP Authentication failed. For Gmail, please use an 'App Password' rather than your regular account password.\"\n            }\n        except Exception as e:\n            return {\n                \"success\": False,\n                \"message\": f\"SMTP Dispatch Error: {str(e)}\"\n            }\n\n    def send_test_email(self) -> Dict[str, Any]:\n        \"\"\"Send verification test email.\"\"\"\n        test_html = \"\"\"\n        <div style=\"font-family: Arial, sans-serif; background: #0f172a; color: #ffffff; padding: 20px; border-radius: 8px;\">\n            <h2 style=\"color: #06b6d4;\">🛡️ AegisShield SMTP Test Verification</h2>\n            <p>This is a test notification confirming that your AegisShield EDR alerting and email configuration is operating properly.</p>\n            <p style=\"color: #10b981; font-weight: bold;\">[✓] SMTP Connection and Authentication Verified.</p>\n        </div>\n        \"\"\"\n        return self.send_email(\"AegisShield EDR - SMTP Test Verification\", test_html)\n","Overwrite":true,"Path":"c:\\Users\\thann\\Downloads\\AntiGravity\\SpywareProcessMon\\backend\\email_notifier.py"}}]}
