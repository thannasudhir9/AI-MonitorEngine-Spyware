{"step_index":151,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:10:32Z","content":"Created At: 2026-11-07T07:10:32+01:00\nCompleted At: 2026-11-07T07:10:32+01:00\nShowing lines 110-150 of 409\n110: \n111: @app.get(\"/api/status\")\n112: def get_system_status():\n113:     \"\"\"Retrieve overall system health, resource consumption, and detector metrics.\"\"\"\n114:     cpu_percent = psutil.cpu_percent(interval=None)\n115:     mem = psutil.virtual_memory()\n116: \n117:     return {\n118:         \"status\": \"ONLINE\",\n119:         \"timestamp\": datetime.now().isoformat(),\n120:         \"cpu_percent\": cpu_percent,\n121:         \"memory_percent\": mem.percent,\n122:         \"memory_used_gb\": round(mem.used / (1024 ** 3), 2),\n123:         \"memory_total_gb\": round(mem.total / (1024 ** 3), 2),\n124:         \"platform\": sys.platform,\n125:         \"process_count\": len(psutil.pids())\n126:     }\n127: \n128: \n129: @app.get(\"/api/scan\")\n130: def run_scan(detailed: bool = False):\n131:     \"\"\"\n132:     Execute full process scan across all active processes.\n133:     Identifies threats, calculates scores, and returns categorized telemetry.\n134:     \"\"\"\n135:     procs = detector.scan_all_processes(detailed_pe=detailed)\n136: \n137:     threats = [p for p in procs if p.get(\"is_threat\")]\n138:     critical_threats = [p for p in threats if p.get(\"severity\") == \"CRITICAL\"]\n139:     high_threats = [p for p in threats if p.get(\"severity\") == \"HIGH\"]\n140:     rmm_tools = [p for p in procs if \"REMOTE CONTROL\" in p.get(\"primary_category\", \"\") or any(\"Remote Desktop\" in r.get(\"vector\", \"\") for r in p.get(\"reasons\", []))]\n141: \n142:     # System Health Index (100 = safe, 0 = critical breach)\n143:     threat_index = 100 - min(len(critical_threats) * 35 + len(high_threats) * 15, 100)\n144: \n145:     return {\n146:         \"scan_time\": datetime.now().isoformat(),\n147:         \"total_processes\": len(procs),\n148:         \"total_threats\": len(threats),\n149:         \"critical_count\": len(critical_threats),\n150:         \"high_count\": len(high_threats),"}
