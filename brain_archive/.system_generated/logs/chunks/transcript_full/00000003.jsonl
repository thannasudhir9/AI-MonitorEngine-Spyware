{"step_index":135,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:09:37Z","content":"Created At: 2026-11-07T07:09:37+01:00\nCompleted At: 2026-11-07T07:09:37+01:00\nShowing lines 200-285 of 342\n200:                     reasons.append({\n201:                         \"vector\": \"High-Risk Execution Directory\",\n202:                         \"severity\": \"HIGH\",\n203:                         \"score\": 40,\n204:                         \"detail\": f\"Process is executing from a known malware drop zone ({susp_path}).\"\n205:                     })\n206:                     break\n207: \n208:         # ==============================================================\n209:         # PASS 4: Command Line & LOLBin Abuse Heuristics\n210:         # ==============================================================\n211:         if lower_cmdline:\n212:             for cmd_rule in SUSPICIOUS_CMDLINE_PATTERNS:\n213:                 if cmd_rule[\"pattern\"] in lower_cmdline:\n214:                     threat_score += cmd_rule[\"score\"]\n215:                     categories.add(cmd_rule[\"category\"])\n216:                     reasons.append({\n217:                         \"vector\": f\"Command-Line Anomaly: {cmd_rule['name']}\",\n218:                         \"severity\": cmd_rule[\"severity\"],\n219:                         \"score\": cmd_rule[\"score\"],\n220:                         \"detail\": cmd_rule[\"description\"]\n221:                     })\n222: \n223:         # ==============================================================\n224:         # PASS 5: Suspicious Parent-Child Process Relationship\n225:         # ==============================================================\n226:         if parent_name:\n227:             for tree_rule in SUSPICIOUS_PARENT_CHILD:\n228:                 if parent_name in tree_rule[\"parent\"] and lower_name in tree_rule[\"children\"]:\n229:                     threat_score += tree_rule[\"score\"]\n230:                     categories.add(tree_rule[\"category\"])\n231:                     reasons.append({\n232:                         \"vector\": f\"Suspicious Process Ancestry: {tree_rule['name']}\",\n233:                         \"severity\": tree_rule[\"severity\"],\n234:                         \"score\": tree_rule[\"score\"],\n235:                         \"detail\": f\"Parent process '{parent_name}' spawned anomalous shell '{name}'.\"\n236:                     })\n237: \n238:         # ==============================================================\n239:         # PASS 6: Network Telemetry & Socket Inspection\n240:         # ==============================================================\n241:         network_summary = get_process_network_summary(pid, network_cache)\n242:         if network_summary[\"network_threat_score\"] > 0:\n243:             threat_score += network_summary[\"network_threat_score\"]\n244:             categories.add(\"Suspicious Network Activity\")\n245:             for flag in network_summary[\"network_flags\"]:\n246:                 reasons.append({\n247:                     \"vector\": \"Network Telemetry Alert\",\n248:                     \"severity\": \"HIGH\",\n249:                     \"score\": 35,\n250:                     \"detail\": flag\n251:                 })\n252: \n253:         # ==============================================================\n254:         # PASS 7: PE Binary Static Analysis (Entropy & APIs)\n255:         # ==============================================================\n256:         pe_meta = {}\n257:         if detailed_pe and exe_path and os.path.isfile(exe_path):\n258:             pe_meta = analyze_binary(exe_path)\n259:             if pe_meta.get(\"is_packed\"):\n260:                 threat_score += 25\n261:                 categories.add(\"Packed / Obfuscated Binary\")\n262:                 reasons.append({\n263:                     \"vector\": \"High File Entropy (Packed)\",\n264:                     \"severity\": \"MEDIUM\",\n265:                     \"score\": 25,\n266:                     \"detail\": f\"Binary exhibits high Shannon entropy ({pe_meta.get('file_entropy')}), indicating crypter/packer evasion.\"\n267:                 })\n268: \n269:             if pe_meta.get(\"api_score\", 0) > 0:\n270:                 api_score = pe_meta[\"api_score\"]\n271:                 threat_score += api_score\n272:                 api_names = [a[\"api\"] for a in pe_meta.get(\"matched_apis\", [])]\n273:                 reasons.append({\n274:                     \"vector\": \"Suspicious API Imports\",\n275:                     \"severity\": \"HIGH\" if api_score >= 30 else \"MEDIUM\",\n276:                     \"score\": api_score,\n277:                     \"detail\": f\"Binary imports dangerous APIs ({', '.join(api_names[:4])}).\"\n278:                 })\n279: \n280:         # Normalize total Threat Score (0 - 100)\n281:         final_score = min(threat_score, 100)\n282: \n283:         # Determine Severity Level\n284:         if final_score >= SCORE_CRITICAL:\n285:             severity = \"CRITICAL\""}
