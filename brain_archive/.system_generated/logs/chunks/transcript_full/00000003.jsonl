{"step_index":143,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:10:04Z","content":"Created At: 2026-11-07T07:10:04+01:00\nCompleted At: 2026-11-07T07:10:04+01:00\nShowing lines 170-265 of 265\n170:     \"\"\"Retrieve dedicated overview of remote desktop & RMM tools and sockets.\"\"\"\n171:     procs = detector.scan_all_processes(detailed_pe=False)\n172:     rmm_procs = [\n173:         p for p in procs\n174:         if \"REMOTE CONTROL\" in p.get(\"primary_category\", \"\")\n175:         or any(\"Remote Desktop\" in r.get(\"vector\", \"\") for r in p.get(\"reasons\", []))\n176:     ]\n177:     return {\n178:         \"timestamp\": datetime.now().isoformat(),\n179:         \"total_active_rmm\": len(rmm_procs),\n180:         \"rmm_processes\": rmm_procs\n181:     }\n182: \n183: \n184: @app.get(\"/api/persistence\")\n185: def get_persistence():\n186:     \"\"\"Scan and retrieve startup folders, registry keys, and scheduled tasks.\"\"\"\n187:     entries = get_all_persistence_entries()\n188:     suspicious = [e for e in entries if e.get(\"is_suspicious\")]\n189:     return {\n190:         \"total\": len(entries),\n191:         \"suspicious_count\": len(suspicious),\n192:         \"entries\": entries\n193:     }\n194: \n195: \n196: @app.post(\"/api/persistence/disable\")\n197: def disable_persistence(req: PersistenceDisableRequest):\n198:     \"\"\"Disable or remove an autorun persistence mechanism.\"\"\"\n199:     result = disable_persistence_item(req.id, req.target_path, req.location_type)\n200:     return result\n201: \n202: \n203: @app.get(\"/api/audit-log\")\n204: def get_audit_log(limit: int = 100):\n205:     \"\"\"Retrieve recent remediation actions, kills, and scan audit logs.\"\"\"\n206:     return remediator.get_audit_log(limit=limit)\n207: \n208: \n209: @app.post(\"/api/simulator/spawn\")\n210: def spawn_test_threat(req: SimulateRequest):\n211:     \"\"\"Spawn a harmless test process mimicking threat behavior for safe verification.\"\"\"\n212:     result = spawn_simulated_threat(req.type)\n213:     return result\n214: \n215: \n216: @app.post(\"/api/simulator/cleanup\")\n217: def cleanup_simulations():\n218:     \"\"\"Clean up any active test simulations.\"\"\"\n219:     result = stop_all_simulations()\n220:     return result\n221: \n222: \n223: # ==============================================================\n224: # WebSockets Real-Time Telemetry Stream\n225: # ==============================================================\n226: \n227: @app.websocket(\"/ws/telemetry\")\n228: async def websocket_telemetry(websocket: WebSocket):\n229:     \"\"\"High-frequency telemetry stream pushing CPU, RAM, and quick threat stats.\"\"\"\n230:     await websocket.accept()\n231:     try:\n232:         while True:\n233:             cpu = psutil.cpu_percent(interval=None)\n234:             mem = psutil.virtual_memory()\n235:             pids_count = len(psutil.pids())\n236: \n237:             data = {\n238:                 \"timestamp\": datetime.now().isoformat(),\n239:                 \"time_display\": datetime.now().strftime(\"%H:%M:%S\"),\n240:                 \"cpu_percent\": cpu,\n241:                 \"memory_percent\": mem.percent,\n242:                 \"process_count\": pids_count\n243:             }\n244:             await websocket.send_json(data)\n245:             await asyncio.sleep(2.0)\n246:     except WebSocketDisconnect:\n247:         pass\n248:     except Exception:\n249:         pass\n250: \n251: \n252: # ==============================================================\n253: # Mount Static Frontend\n254: # ==============================================================\n255: \n256: if FRONTEND_DIR.exists():\n257:     app.mount(\"/static\", StaticFiles(directory=str(FRONTEND_DIR)), name=\"static\")\n258: \n259:     @app.get(\"/\")\n260:     def serve_dashboard():\n261:         index_file = FRONTEND_DIR / \"index.html\"\n262:         if index_file.exists():\n263:             return FileResponse(index_file)\n264:         return JSONResponse({\"status\": \"AegisShield Backend Running\", \"message\": \"Frontend UI file missing\"})\n265: "}
