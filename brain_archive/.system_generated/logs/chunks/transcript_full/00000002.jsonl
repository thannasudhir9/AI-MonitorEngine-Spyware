ote Desktop & RAT Hunter\n            </button>\n            <button data-tab=\"processes\" class=\"tab-btn px-4 py-2.5 rounded-t-lg text-slate-400 border-b-2 border-transparent hover:text-white flex items-center gap-2 font-medium\">\n                <i data-lucide=\"list-tree\" class=\"w-4 h-4\"></i> Live Process Monitor\n            </button>\n            <button data-tab=\"persistence\" class=\"tab-btn px-4 py-2.5 rounded-t-lg text-slate-400 border-b-2 border-transparent hover:text-white flex items-center gap-2 font-medium\">\n                <i data-lucide=\"rocket\" class=\"w-4 h-4\"></i> Persistence & Startup\n            </button>\n            <button data-tab=\"simulation\" class=\"tab-btn px-4 py-2.5 rounded-t-lg text-slate-400 border-b-2 border-transparent hover:text-white flex items-center gap-2 font-medium\">\n                <i data-lucide=\"flask-conical\" class=\"w-4 h-4 text-purple-400\"></i> Simulation Lab\n            </button>\n            <button data-tab=\"audit\" class=\"tab-btn px-4 py-2.5 rounded-t-lg text-slate-400 border-b-2 border-transparent hover:text-white flex items-center gap-2 font-medium\">\n                <i data-lucide=\"history\" class=\"w-4 h-4\"></i> Incident Audit Log\n            </button>\n        </nav>\n\n        <!-- ========================================== -->\n        <!-- TAB 1: ACTIVE THREATS & REMEDIATION -->\n        <!-- ========================================== -->\n        <section id=\"view-threats\" class=\"tab-content space-y-4\">\n            <div class=\"flex items-center justify-between\">\n                <div>\n                    <h2 class=\"text-base font-bold font-mono text-white\">Active Threat Vectors</h2>\n                    <p class=\"text-xs text-slate-400\">Processes exceeding risk thresholds via signatures, LOLRMM, masquerading, or injected APIs.</p>\n                </div>\n                <div class=\"text-xs text-slate-400 font-mono\">\n                    Showing real-time detections with direct kill controls\n                </div>\n            </div>\n\n            <!-- Threats Grid Container -->\n            <div id=\"threats-grid\" class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                <!-- Rendered dynamically by JavaScript -->\n            </div>\n        </section>\n\n        <!-- ========================================== -->\n        <!-- TAB 2: REMOTE DESKTOP & RAT HUNTER -->\n        <!-- ========================================== -->\n        <section id=\"view-rmm\" class=\"tab-content hidden space-y-4\">\n            <div class=\"flex items-center justify-between\">\n                <div>\n                    <h2 class=\"text-base font-bold font-mono text-cyan-300\">Remote Desktop, VNC, RMM & RAT Monitor</h2>\n                    <p class=\"text-xs text-slate-400\">Tracks AnyDesk, TeamViewer, RustDesk, ScreenConnect, VNC, and reverse ingress tunnels (LOLRMM).</p>\n                </div>\n            </div>\n\n            <div class=\"cyber-card overflow-hidden\">\n                <div class=\"overflow-x-auto\">\n                    <table class=\"w-full text-left text-xs font-mono\">\n                        <thead class=\"bg-slate-900/80 border-b border-slate-800 text-slate-400\">\n                            <tr>\n                                <th class=\"p-3\">Software / Tool</th>\n                                <th class=\"p-3\">PID</th>\n                                <th class=\"p-3\">Category</th>\n                                <th class=\"p-3\">Executable Path</th>\n                                <th class=\"p-3\">Network Sockets / Ports</th>\n                                <th class=\"p-3 text-right\">Action</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"rmm-table-body\">\n                            <!-- Populated dynamically -->\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </section>\n\n        <!-- ========================================== -->\n        <!-- TAB 3: LIVE PROCESS MONITOR -->\n        <!-- ========================================== -->\n        <section id=\"view-processes\" class=\"tab-content hidden space-y-4\">\n            <!-- Search & Filter Controls -->\n            <div class=\"flex flex-col sm:flex-row items-center justify-between gap-3\">\n                <div class=\"relative w-full sm:w-96\">\n                    <i data-lucide=\"search\" class=\"w-4 h-4 text-slate-500 absolute left-3 top-2.5\"></i>\n                    <input \n                        type=\"text\" \n                        id=\"process-search\" \n                        oninput=\"setSearchQuery(this.value)\" \n                        placeholder=\"Search by PID, Name, Path, or User...\" \n                        class=\"w-full bg-slate-900/90 border border-slate-800 rounded-lg pl-9 pr-4 py-2 text-xs font-mono text-white focus:outline-none focus:border-cyan-500 placeholder-slate-500\"\n                    >\n                </div>\n\n                <div class=\"flex items-center gap-1.5 w-full sm:w-auto font-mono text-xs\">\n                    <button onclick=\"setProcessFilter('all')\" data-filter=\"all\" class=\"proc-filter-btn px-3 py-1.5 rounded-lg bg-cyan-600 text-white font-medium\">All</button>\n                    <button onclick=\"setProcessFilter('threats')\" data-filter=\"threats\" class=\"proc-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:text-white\">Threats Only</button>\n                    <button onclick=\"setProcessFilter('rmm')\" data-filter=\"rmm\" class=\"proc-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:text-white\">Remote Control</button>\n                    <button onclick=\"setProcessFilter('high_cpu')\" data-filter=\"high_cpu\" class=\"proc-filter-btn px-3 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:text-white\">High CPU</button>\n                </div>\n  