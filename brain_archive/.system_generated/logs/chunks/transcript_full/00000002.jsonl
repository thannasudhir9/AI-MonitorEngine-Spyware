{"step_index":77,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-07T06:04:19Z","input_tokens":2176,"cache_read_tokens":81870,"output_tokens":506,"tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\nAegisShield - Server Launcher Script\nStarts the FastAPI application and opens the Cyber SOC Dashboard in the browser.\n\"\"\"\n\nimport sys\nimport time\nimport webbrowser\nimport threading\nimport uvicorn\nfrom backend.config import SERVER_HOST, SERVER_PORT\n\n\ndef open_browser():\n    \"\"\"Wait for server startup and launch dashboard in user's browser.\"\"\"\n    time.sleep(1.2)\n    url = f\"http://{SERVER_HOST}:{SERVER_PORT}\"\n    print(f\"\\n[✓] Launching AegisShield Dashboard: {url}\")\n    try:\n        webbrowser.open(url)\n    except Exception:\n        pass\n\n\ndef main():\n    print(\"\"\"\n    ===============================================================\n       AEGISSHIELD - CYBER PROCESS MONITOR & THREAT ERADICATOR\n    ===============================================================\n    [*] Dashboard Web UI: http://127.0.0.1:8888\n    [*] API Docs:         http://127.0.0.1:8888/docs\n    [*] Press Ctrl+C to stop the monitoring server.\n    ===============================================================\n    \"\"\")\n\n    # Open browser automatically in a background thread\n    threading.Thread(target=open_browser, daemon=True).start()\n\n    # Start Uvicorn ASGI server\n    uvicorn.run(\n        \"backend.server:app\",\n        host=SERVER_HOST,\n        port=SERVER_PORT,\n        log_level=\"info\",\n        reload=False\n    )\n\n\nif __name__ == \"__main__\":\n    main()\n","Overwrite":true,"Path":"c:\\Users\\thann\\Downloads\\AntiGravity\\SpywareProcessMon\\run_server.py"}}]}
