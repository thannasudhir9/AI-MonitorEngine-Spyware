n.\"\"\"\n212:     result = spawn_simulated_threat(req.type)\n213:     return result\n214: \n215: \n216: @app.post(\"/api/simulator/cleanup\")\n217: def cleanup_simulations():\n218:     \"\"\"Clean up any active test simulations.\"\"\"\n219:     result = stop_all_simulations()\n220:     return result\n221: \n222: \n223: # ==============================================================\n224: # WebSockets Real-Time Telemetry Stream\n225: # ==============================================================\n226: \n227: @app.websocket(\"/ws/telemetry\")\n228: async def websocket_telemetry(websocket: WebSocket):\n229:     \"\"\"High-frequency telemetry stream pushing CPU, RAM, and quick threat stats.\"\"\"\n230:     await websocket.accept()\n231:     try:\n232:         while True:\n233:             cpu = psutil.cpu_percent(interval=None)\n234:             mem = psutil.virtual_memory()\n235:             pids_count = len(psutil.pids())\n236: \n237:             data = {\n238:                 \"timestamp\": datetime.now().isoformat(),\n239:                 \"time_display\": datetime.now().strftime(\"%H:%M:%S\"),\n240:                 \"cpu_percent\": cpu,\n241:                 \"memory_percent\": mem.percent,\n242:                 \"process_count\": pids_count\n243:             }\n244:             await websocket.send_json(data)\n245:             await asyncio.sleep(2.0)\n246:     except WebSocketDisconnect:\n247:         pass\n248:     except Exception:\n249:         pass\n250: \n251: \n252: # ==============================================================\n253: # Mount Static Frontend\n254: # ==============================================================\n255: \n256: if FRONTEND_DIR.exists():\n257:     app.mount(\"/static\", StaticFiles(directory=str(FRONTEND_DIR)), name=\"static\")\n258: \n259:     @app.get(\"/\")\n260:     def serve_dashboard():\n261:         index_file = FRONTEND_DIR / \"index.html\"\n262:         if index_file.exists():\n263:             return FileResponse(index_file)\n264:         return JSONResponse({\"status\": \"AegisShield Backend Running\", \"message\": \"Frontend UI file missing\"})\n265: "}
