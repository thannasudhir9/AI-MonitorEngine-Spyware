\": cpu,\n409:                 \"memory_percent\": mem.percent,\n410:                 \"process_count\": pids_count\n411:             }\n412:             await websocket.send_json(data)\n413:             await asyncio.sleep(2.0)\n414:     except WebSocketDisconnect:\n415:         pass\n416:     except Exception:\n417:         pass\n418: \n419: \n420: # ==============================================================\n421: # Mount Static Frontend\n422: # ==============================================================\n423: \n424: if FRONTEND_DIR.exists():\n425:     app.mount(\"/static\", StaticFiles(directory=str(FRONTEND_DIR)), name=\"static\")\n426: \n427:     @app.get(\"/\")\n428:     def serve_dashboard():\n429:         index_file = FRONTEND_DIR / \"index.html\"\n430:         if index_file.exists():\n431:             return FileResponse(index_file)\n432:         return JSONResponse({\"status\": \"AegisShield Backend Running\", \"message\": \"Frontend UI file missing\"})\n433: "}
