{"step_index":309,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:31:41Z","content":"Created At: 2026-11-07T07:31:41+01:00\nCompleted At: 2026-11-07T07:31:41+01:00\nShowing lines 1-100 of 226\n1: \"\"\"\n2: AegisShield - Master Diagnostic & Testing Engine\n3: Executes automated unit, integration, and end-to-end tests across all EDR subsystems:\n4: Threat Detection, Process Eradication, Allow/Block Policies, Network Tracer,\n5: AdBlock Proxy, Web Traffic Logging, Analytics, and Email Dispatch.\n6: \"\"\"\n7: \n8: import sys\n9: import time\n10: import socket\n11: import psutil\n12: import subprocess\n13: from datetime import datetime\n14: from pathlib import Path\n15: \n16: # Add project root to sys.path\n17: APP_ROOT = Path(__file__).resolve().parent.parent\n18: sys.path.insert(0, str(APP_ROOT))\n19: \n20: from backend.detector import ThreatDetector\n21: from backend.remediator import ThreatRemediator\n22: from backend.policy_engine import PolicyEngine\n23: from backend.network_tracer import NetworkTracer\n24: from backend.adblock_rules import check_domain_reputation\n25: from backend.web_traffic_logger import WebTrafficLogger\n26: from backend.web_analytics import WebAnalytics\n27: from backend.adblock_proxy import AdBlockProxyServer\n28: from backend.email_notifier import EmailNotifier\n29: from backend.simulator import spawn_simulated_threat\n30: \n31: \n32: # Formatting\n33: GREEN = \"\\033[92m\"\n34: RED = \"\\033[91m\"\n35: CYAN = \"\\033[96m\"\n36: YELLOW = \"\\033[93m\"\n37: BOLD = \"\\033[1m\"\n38: RESET = \"\\033[0m\"\n39: \n40: \n41: class TestRunner:\n42:     def __init__(self):\n43:         self.passed = 0\n44:         self.failed = 0\n45:         self.results = []\n46: \n47:     def record(self, test_name: str, success: bool, detail: str = \"\"):\n48:         if success:\n49:             self.passed += 1\n50:             print(f\"  {GREEN}[PASS]{RESET} {test_name} {CYAN}{detail}{RESET}\")\n51:         else:\n52:             self.failed += 1\n53:             print(f\"  {RED}[FAIL]{RESET} {test_name} - {RED}{detail}{RESET}\")\n54:         self.results.append({\"name\": test_name, \"success\": success, \"detail\": detail})\n55: \n56: \n57: def run_all_tests():\n58:     print(f\"\"\"\n<truncated 601 bytes>\n runner = TestRunner()\n66: \n67:     # ==============================================================\n68:     # Test Suite 1: Threat Detection Engine\n69:     # ==============================================================\n70:     print(f\"\\n{BOLD}[1/8] Testing Threat Detection & Heuristic Scoring Engine...{RESET}\")\n71:     detector = ThreatDetector()\n72:     procs = detector.scan_all_processes(detailed_pe=False)\n73:     runner.record(\"Process Enumeration\", len(procs) > 0, f\"Scanned {len(procs)} processes\")\n74: \n75:     # Masquerading detection\n76:     sim_threat = detector.evaluate_process(psutil.Process(psutil.pids()[0]))\n77:     runner.record(\"Process Evaluation\", sim_threat is not None, f\"Evaluated PID {psutil.pids()[0]}\")\n78: \n79:     # ==============================================================\n80:     # Test Suite 2: Process Eradication & Remediation\n81:     # ==============================================================\n82:     print(f\"\\n{BOLD}[2/8] Testing Remediation & Eradication Engine...{RESET}\")\n83:     remediator = ThreatRemediator()\n84:     sim = spawn_simulated_threat(\"encoded_cmdline\")\n85:     test_pid = sim[\"pid\"]\n86:     runner.record(\"Threat Simulation\", sim[\"success\"], f\"Spawned test PID {test_pid}\")\n87: \n88:     kill_res = remediator.kill_process(test_pid, force=True, reason=\"Test Engine Kill\")\n89:     time.sleep(0.3)\n90:     is_dead = not psutil.pid_exists(test_pid)\n91:     runner.record(\"Process Eradication (Kill)\", is_dead, f\"Terminated PID {test_pid} successfully\")\n92: \n93:     # ==============================================================\n94:     # Test Suite 3: Access Control Policy Engine (Allow / Block)\n95:     # ==============================================================\n96:     print(f\"\\n{BOLD}[3/8] Testing Access Control (Allowlist & Blocklist) Engine...{RESET}\")\n97:     policy = PolicyEngine()\n98:     allow_res = policy.add_allow_rule(\"name\", \"safe_unit_test.exe\", \"Diagnostic check\")\n99:     runner.record(\"Add Allow Rule\", allow_res[\"success\"], allow_res[\"message\"])\n100: ","truncated_fields":["content"]}
