00', 'text-white');\n1295:             btn.classList.add('bg-slate-800', 'text-slate-400');\n1296:         }\n1297:     });\n1298:     if (state.lastScanData) {\n1299:         renderProcessTable(state.lastScanData.processes);\n1300:     }\n1301: }\n1302: \n1303: function toggleAutoRefresh() {\n1304:     state.autoRefresh = !state.autoRefresh;\n1305:     const btn = document.getElementById('btn-auto-refresh');\n1306:     if (btn) {\n1307:         btn.innerHTML = state.autoRefresh ? \n1308:             `<i data-lucide=\"refresh-cw\" class=\"w-4 h-4 text-emerald-400 animate-spin\"></i> Auto-Refresh: ON` : \n1309:             `<i data-lucide=\"pause\" class=\"w-4 h-4 text-slate-400\"></i> Auto-Refresh: PAUSED`;\n1310:         if (window.lucide) lucide.createIcons();\n1311:     }\n1312: }"}
