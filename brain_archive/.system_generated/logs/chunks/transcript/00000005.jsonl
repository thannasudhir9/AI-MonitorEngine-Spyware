{"step_index":443,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:48:27Z","content":"Created At: 2026-11-07T07:48:27+01:00\nCompleted At: 2026-11-07T07:48:27+01:00\nShowing lines 1-60 of 504\n1: \"\"\"\n2: AegisShield - FastAPI Server & Cyber SOC Dashboard Backend\n3: Provides RESTful APIs, WebSockets telemetry, and serves the frontend dashboard.\n4: \"\"\"\n5: \n6: import os\n7: import sys\n8: import psutil\n9: import asyncio\n10: from datetime import datetime\n11: from pathlib import Path\n12: from typing import Dict, List, Any, Optional\n13: \n14: from fastapi import FastAPI, WebSocket, WebSocketDisconnect, HTTPException\n15: from fastapi.middleware.cors import CORSMiddleware\n16: from fastapi.staticfiles import StaticFiles\n17: from fastapi.responses import FileResponse, JSONResponse\n18: from pydantic import BaseModel\n19: \n20: from .config import SERVER_HOST, SERVER_PORT, APP_ROOT, SCORE_MEDIUM\n21: from .detector import ThreatDetector\n22: from .remediator import ThreatRemediator\n23: from .persistence_hunter import get_all_persistence_entries, disable_persistence_item\n24: from .network_monitor import scan_network_connections\n25: from .simulator import spawn_simulated_threat, stop_all_simulations\n26: from .policy_engine import PolicyEngine\n27: from .network_tracer import NetworkTracer\n28: from .email_notifier import EmailNotifier\n29: from .adblock_proxy import AdBlockProxyServer\n30: from .web_traffic_logger import WebTrafficLogger\n31: from .web_analytics import WebAnalytics\n32: from .proxy_controller import ProxyController\n33: \n34: app = FastAPI(title=\"AegisShield Cyber Threat & Process Monitor\", version=\"2.0.0\")\n35: \n36: # Enable CORS for local access\n37: app.add_middleware(\n38:     CORSMiddleware,\n39:     allow_origins=[\"*\"],\n40:     allow_credentials=True,\n41:     allow_methods=[\"*\"],\n42:     allow_headers=[\"*\"],\n43: )\n44: \n45: policy_engine = PolicyEngine()\n46: detector = ThreatDetector()\n47: detector.policy_engine = policy_engine\n48: remediator = ThreatRemediator()\n49: network_tracer = NetworkTracer()\n50: email_notifier = EmailNotifier()\n51: \n52: # AdBlock & Web Traffic Interception\n53: adblock_proxy = AdBlockProxyServer(host=\"127.0.0.1\", port=8080)\n54: adblock_proxy.start()\n55: web_traffic_logger = WebTrafficLogger()\n56: web_analytics = WebAnalytics()\n57: proxy_controller = ProxyController(proxy_host=\"127.0.0.1\", proxy_port=8080)\n58: \n59: FRONTEND_DIR = APP_ROOT / \"frontend\"\n60: "}
