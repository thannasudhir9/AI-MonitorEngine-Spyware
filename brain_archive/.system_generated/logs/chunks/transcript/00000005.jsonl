{"step_index":445,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:48:31Z","content":"Created At: 2026-11-07T07:48:31+01:00\nCompleted At: 2026-11-07T07:48:31+01:00\nShowing lines 1-51 of 51\n1: \"\"\"\n2: AegisShield - Server Launcher Script\n3: Starts the FastAPI application and opens the Cyber SOC Dashboard in the browser.\n4: \"\"\"\n5: \n6: import sys\n7: import time\n8: import webbrowser\n9: import threading\n10: import uvicorn\n11: from backend.config import SERVER_HOST, SERVER_PORT\n12: \n13: \n14: def open_browser():\n15:     \"\"\"Wait for server startup and launch dashboard in user's browser.\"\"\"\n16:     time.sleep(1.2)\n17:     url = f\"http://{SERVER_HOST}:{SERVER_PORT}\"\n18:     print(f\"\\n[✓] Launching AegisShield Dashboard: {url}\")\n19:     try:\n20:         webbrowser.open(url)\n21:     except Exception:\n22:         pass\n23: \n24: \n25: def main():\n26:     print(\"\"\"\n27:     ===============================================================\n28:        AEGISSHIELD - CYBER PROCESS MONITOR & THREAT ERADICATOR\n29:     ===============================================================\n30:     [*] Dashboard Web UI: http://127.0.0.1:8888\n31:     [*] API Docs:         http://127.0.0.1:8888/docs\n32:     [*] Press Ctrl+C to stop the monitoring server.\n33:     ===============================================================\n34:     \"\"\")\n35: \n36:     # Open browser automatically in a background thread\n37:     threading.Thread(target=open_browser, daemon=True).start()\n38: \n39:     # Start Uvicorn ASGI server\n40:     uvicorn.run(\n41:         \"backend.server:app\",\n42:         host=SERVER_HOST,\n43:         port=SERVER_PORT,\n44:         log_level=\"info\",\n45:         reload=False\n46:     )\n47: \n48: \n49: if __name__ == \"__main__\":\n50:     main()\n51: "}
