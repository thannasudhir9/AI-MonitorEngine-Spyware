"/api/adblock/analytics\")\n449: def get_web_analytics_data():\n450:     \"\"\"Retrieve aggregated browsing metrics, top visited sites, blocked ads, and activity timelines.\"\"\"\n451:     return web_analytics.get_analytics()\n452: \n453: \n454: @app.post(\"/api/adblock/clear-logs\")\n455: def clear_web_traffic_logs():\n456:     \"\"\"Clear recorded web browsing history.\"\"\"\n457:     res = web_traffic_logger.clear_logs()\n458:     remediator.log_event(\"TRAFFIC_LOGS_CLEARED\", \"WebTrafficLogger\", None, \"User cleared web history.\")\n459:     return res\n460: \n461: \n462: # ==============================================================\n463: # WebSockets Real-Time Telemetry Stream\n464: # ==============================================================\n465: \n466: @app.websocket(\"/ws/telemetry\")\n467: async def websocket_telemetry(websocket: WebSocket):\n468:     \"\"\"High-frequency telemetry stream pushing CPU, RAM, and quick threat stats.\"\"\"\n469:     await websocket.accept()\n470:     try:\n471:         while True:\n472:             cpu = psutil.cpu_percent(interval=None)\n473:             mem = psutil.virtual_memory()\n474:             pids_count = len(psutil.pids())\n475: \n476:             data = {\n477:                 \"timestamp\": datetime.now().isoformat(),\n478:                 \"time_display\": datetime.now().strftime(\"%H:%M:%S\"),\n479:                 \"cpu_percent\": cpu,\n480:                 \"memory_percent\": mem.percent,"}
