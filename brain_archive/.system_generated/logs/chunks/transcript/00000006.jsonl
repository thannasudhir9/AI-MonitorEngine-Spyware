{"step_index":538,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:53:31Z","content":"Created At: 2026-11-07T07:53:31+01:00\nCompleted At: 2026-11-07T07:53:31+01:00\nShowing lines 1-60 of 1556\n1: /**\n2:  * AegisShield Cyber SOC Dashboard Controller\n3:  * Real-time threat detection, process monitor, network origin tracer,\n4:  * access control allow/block rules, and email alert reporting.\n5:  */\n6: \n7: // Application State\n8: const state = {\n9:     activeTab: 'threats',\n10:     autoRefresh: true,\n11:     refreshInterval: null,\n12:     telemetryWs: null,\n13:     lastScanData: null,\n14:     processFilter: 'all',\n15:     searchQuery: '',\n16:     netFilter: 'all',\n17:     netSearchQuery: '',\n18:     lastNetworkData: null,\n19:     adblockFilter: 'all',\n20:     adblockSearchQuery: '',\n21:     systemProxyEnabled: false,\n22:     lastAdblockData: null,\n23:     soundEnabled: true,\n24:     isScanning: false,\n25:     selectedProcess: null\n26: };\n27: \n28: // Web Audio API Synthesizer for Cyber Alerts\n29: const CyberAudio = {\n30:     ctx: null,\n31:     init() {\n32:         if (!this.ctx && (window.AudioContext || window.webkitAudioContext)) {\n33:             this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n34:         }\n35:     },\n36:     playChime(type = 'threat') {\n37:         if (!state.soundEnabled) return;\n38:         try {\n39:             this.init();\n40:             if (!this.ctx) return;\n41:             const now = this.ctx.currentTime;\n42:             const osc = this.ctx.createOscillator();\n43:             const gain = this.ctx.createGain();\n44:             osc.connect(gain);\n45:             gain.connect(this.ctx.destination);\n46: \n47:             if (type === 'threat') {\n48:                 osc.type = 'sawtooth';\n49:                 osc.frequency.setValueAtTime(440, now);\n50:                 osc.frequency.exponentialRampToValueAtTime(220, now + 0.35);\n51:                 gain.gain.setValueAtTime(0.15, now);\n52:                 gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);\n53:                 osc.start(now);\n54:                 osc.stop(now + 0.35);\n55:             } else if (type === 'kill') {\n56:                 osc.type = 'sine';\n57:                 osc.frequency.setValueAtTime(587.33, now);\n58:                 osc.frequency.setValueAtTime(880, now + 0.1);\n59:                 gain.gain.setValueAtTime(0.12, now);\n60:                 gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);"}
