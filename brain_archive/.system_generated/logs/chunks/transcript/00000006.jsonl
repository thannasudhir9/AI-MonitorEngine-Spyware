{"step_index":520,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:52:36Z","content":"Created At: 2026-11-07T07:52:36+01:00\nCompleted At: 2026-11-07T07:52:36+01:00\nShowing lines 150-200 of 259\n150:         print(f\"  • {BOLD}{b['value']}{RESET} [{b['type']}] - {b.get('comment')}\")\n151: \n152:     print(f\"\\n{YELLOW}{BOLD}Banned IP Addresses (Firewall Block):{RESET}\")\n153:     for ip in rules.get(\"blocked_ips\", []):\n154:         print(f\"  • {BOLD}{ip['value']}{RESET} - {ip.get('comment')}\")\n155: \n156: \n157: def main():\n158:     print_banner()\n159:     parser = argparse.ArgumentParser(description=\"AegisShield Terminal Threat Hunter\")\n160:     parser.add_argument(\"--scan\", action=\"store_true\", help=\"Execute process threat scan\")\n161:     parser.add_argument(\"--kill\", action=\"store_true\", help=\"Automatically kill detected threats (use with --scan)\")\n162:     parser.add_argument(\"--network\", action=\"store_true\", help=\"Audit processes using network sockets and trace IP origins\")\n163:     parser.add_argument(\"--rmm\", action=\"store_true\", help=\"Check for Remote Desktop / RMM / VNC processes\")\n164:     parser.add_argument(\"--persistence\", action=\"store_true\", help=\"Check Windows Startup and Registry persistence\")\n165:     parser.add_argument(\"--rules\", action=\"store_true\", help=\"Display all active allowlist and blocklist rules\")\n166:     parser.add_argument(\"--allow\", type=str, help=\"Add process name to trusted allowlist\")\n167:     parser.add_argument(\"--block\", type=str, help=\"Add process name or IP address to blocklist\")\n168:     parser.add_argument(\"--email-report\", type=str, help=\"Generate and send HTML security report to specified recipient email\")\n169:     parser.add_argument(\"--kill-pid\", type=int, help=\"Forcefully terminate a single process by PID\")\n170:     parser.add_argument(\"--kill-tree\", type=int, help=\"Forcefully terminate process and all child processes\")\n171:     parser.add_argument(\"--min-score\", type=int, default=50, help=\"Minimum threat score to terminate (default 50)\")\n172: \n173:     args = parser.parse_args()\n174: \n175:     remediator = ThreatRemediator()\n176:     policy = PolicyEngine()\n177: \n178:     if args.allow:\n179:         res = policy.add_allow_rule(\"name\", args.allow, comment=\"CLI Allowlist Entry\")\n180:         print(f\"{GREEN}[✓] {res['message']}{RESET}\")\n181:         return\n182: \n183:     if args.block:\n184:         target = args.block.strip()\n185:         is_ip = target.replace(\".\", \"\").isdigit() and target.count(\".\") == 3\n186:         if is_ip:\n187:             res = policy.add_ip_block_rule(target, comment=\"CLI IP Ban\", apply_firewall=True)\n188:         else:\n189:             res = policy.add_block_rule(\"name\", target, comment=\"CLI Process Ban\")\n190:         print(f\"{RED}[✓] {res['message']}{RESET}\")\n191:         return\n192: \n193:     if args.rules:\n194:         run_policy_rules()\n195:         return\n196: \n197:     if args.network:\n198:         run_network_audit()\n199:         return\n200: "}
