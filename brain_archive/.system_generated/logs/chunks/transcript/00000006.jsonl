{"step_index":518,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:52:32Z","content":"Created At: 2026-11-07T07:52:32+01:00\nCompleted At: 2026-11-07T07:52:32+01:00\nShowing lines 200-259 of 259\n200: \n201:     if args.email_report:\n202:         notifier = EmailNotifier()\n203:         detector = ThreatDetector()\n204:         tracer = NetworkTracer()\n205:         print(f\"{CYAN}[*] Compiling full security posture report for {args.email_report}...{RESET}\")\n206:         scan_data = detector.scan_all_processes(detailed_pe=False)\n207:         threats = [p for p in scan_data if p.get(\"is_threat\")]\n208:         net_data = tracer.audit_all_network_processes()\n209:         payload = {\n210:             \"threats\": threats,\n211:             \"rmm_tools\": [p for p in scan_data if \"REMOTE CONTROL\" in p.get(\"primary_category\", \"\")],\n212:             \"total_processes\": len(scan_data),\n213:             \"system_health_index\": 100 - min(len(threats) * 25, 100),\n214:             \"network\": net_data\n215:         }\n216:         html = notifier.generate_html_report(payload)\n217:         subject = f\"🛡️ AegisShield Security Audit - {len(threats)} Threats Detected\"\n218:         res = notifier.send_email(subject, html, recipient=args.email_report)\n219:         if res[\"success\"]:\n220:             print(f\"{GREEN}[✓] {res['message']}{RESET}\")\n221:         else:\n222:             print(f\"{RED}[✗] {res['message']}{RESET}\")\n223:         return\n224: \n225:     if args.kill_pid:\n226:         res = remediator.kill_process(args.kill_pid, force=True, reason=\"CLI Force Kill\")\n227:         if res[\"success\"]:\n228:             print(f\"{GREEN}[✓] {res['message']}{RESET}\")\n229:         else:\n230:             print(f\"{RED}[✗] {res['message']}{RESET}\")\n231:         return\n232: \n233:     if args.kill_tree:\n234:         res = remediator.kill_process_tree(args.kill_tree, reason=\"CLI Tree Eradication\")\n235:         if res[\"success\"]:\n236:             print(f\"{GREEN}[✓] {res['message']}{RESET}\")\n237:         else:\n238:             print(f\"{RED}[✗] {res['message']}{RESET}\")\n239:         return\n240: \n241:     if args.rmm:\n242:         run_rmm_check()\n243:         return\n244: \n245:     if args.persistence:\n246:         print(f\"{CYAN}[*] Scanning Windows Startup and Registry persistence...{RESET}\")\n247:         entries = get_all_persistence_entries()\n248:         suspicious = [e for e in entries if e.get(\"is_suspicious\")]\n249:         print(f\"[+] Total entries: {len(entries)} | Suspicious: {len(suspicious)}\")\n250:         for s in suspicious:\n251:             print(f\"{YELLOW}[!] {s['name']} - {s['target_path']}{RESET}\")\n252:         return\n253: \n254:     # Default: Run full process scan\n255:     run_cli_scan(kill_mode=args.kill, min_score=args.min_score)\n256: \n257: \n258: if __name__ == \"__main__\":\n259:     main()"}
