{"step_index":516,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:52:30Z","content":"Created At: 2026-11-07T07:52:30+01:00\nCompleted At: 2026-11-07T07:52:30+01:00\nShowing lines 1-60 of 259\n1: \"\"\"\n2: AegisShield CLI - Terminal Threat Hunter, Process Eradicator & Network Origin Tracer\n3: Usage:\n4:     python cli_scanner.py --scan\n5:     python cli_scanner.py --scan --kill\n6:     python cli_scanner.py --network\n7:     python cli_scanner.py --rmm\n8:     python cli_scanner.py --allow <process_name>\n9:     python cli_scanner.py --block <process_name_or_ip>\n10:     python cli_scanner.py --rules\n11:     python cli_scanner.py --email-report <recipient_email>\n12:     python cli_scanner.py --kill-pid <PID>\n13:     python cli_scanner.py --kill-tree <PID>\n14: \"\"\"\n15: \n16: import sys\n17: import argparse\n18: from datetime import datetime\n19: \n20: from backend.detector import ThreatDetector\n21: from backend.remediator import ThreatRemediator\n22: from backend.persistence_hunter import get_all_persistence_entries\n23: from backend.policy_engine import PolicyEngine\n24: from backend.network_tracer import NetworkTracer\n25: from backend.email_notifier import EmailNotifier\n26: \n27: \n28: # ANSI Color formatting\n29: CYAN = \"\\033[96m\"\n30: GREEN = \"\\033[92m\"\n31: YELLOW = \"\\033[93m\"\n32: RED = \"\\033[91m\"\n33: BOLD = \"\\033[1m\"\n34: DIM = \"\\033[2m\"\n35: RESET = \"\\033[0m\"\n36: \n37: \n38: def print_banner():\n39:     print(f\"\"\"{CYAN}{BOLD}\n40:     ╔══════════════════════════════════════════════════════════════╗\n41:     ║       AEGISSHIELD EDR - ADVANCED PROCESS THREAT HUNTER       ║\n42:     ║   Spyware • Antivirus • Remote Desktop • Trojan Eradicator   ║\n43:     ║          Access Control • Network Tracer • Email Alerts      ║\n44:     ╚══════════════════════════════════════════════════════════════╝{RESET}\n45:     \"\"\")\n46: \n47: \n48: def run_cli_scan(kill_mode: bool = False, min_score: int = 50):\n49:     detector = ThreatDetector()\n50:     remediator = ThreatRemediator()\n51: \n52:     print(f\"{CYAN}[*] Initiating deep system process scan...{RESET}\")\n53:     start_time = datetime.now()\n54:     procs = detector.scan_all_processes(detailed_pe=True)\n55:     duration = (datetime.now() - start_time).total_seconds()\n56: \n57:     threats = [p for p in procs if p.get(\"is_threat\")]\n58:     rmm_tools = [p for p in procs if \"REMOTE CONTROL\" in p.get(\"primary_category\", \"\")]\n59: \n60:     print(f\"{GREEN}[+] Scan Complete in {duration:.2f}s | Analyzed {len(procs)} processes | Found {len(threats)} threats | {len(rmm_tools)} RMM tools{RESET}\\n\")"}
