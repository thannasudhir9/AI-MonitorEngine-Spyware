{"step_index":540,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-07T06:53:34Z","content":"Created At: 2026-11-07T07:53:34+01:00\nCompleted At: 2026-11-07T07:53:34+01:00\nShowing lines 1500-1556 of 1556\n1500:                 </td>\n1501:                 <td class=\"p-3 font-mono text-xs text-cyan-400\">${escapeHtml(r.method)}:${r.port}</td>\n1502:                 <td class=\"p-3 font-mono text-xs text-slate-300\">${escapeHtml(r.category)}</td>\n1503:                 <td class=\"p-3\">${statusBadge}</td>\n1504:                 <td class=\"p-3 text-right\">\n1505:                     ${r.is_blocked ? `\n1506:                         <button onclick=\"quickAllowProcess('${escapeHtml(r.domain)}', 'Domain Whitelist')\" class=\"px-2 py-1 bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 text-[11px] rounded border border-emerald-500/30\">\n1507:                             Allow Domain\n1508:                         </button>\n1509:                     ` : `\n1510:                         <button onclick=\"quickBlockProcess('${escapeHtml(r.domain)}', 'Domain Blocklist')\" class=\"px-2 py-1 bg-red-600/20 hover:bg-red-600/30 text-red-300 text-[11px] rounded border border-red-500/30\">\n1511:                             Block Domain\n1512:                         </button>\n1513:                     `}\n1514:                 </td>\n1515:             </tr>\n1516:         `;\n1517:     }).join('');\n1518: }\n1519: \n1520: function setTrafficFilter(f) {\n1521:     state.adblockFilter = f;\n1522:     document.querySelectorAll('.traffic-filter-btn').forEach(btn => {\n1523:         if (btn.dataset.trafficFilter === f) {\n1524:             btn.classList.add('bg-rose-600', 'text-white');\n1525:             btn.classList.remove('bg-slate-800', 'text-slate-400');\n1526:         } else {\n1527:             btn.classList.remove('bg-rose-600', 'text-white');\n1528:             btn.classList.add('bg-slate-800', 'text-slate-400');\n1529:         }\n1530:     });\n1531:     if (state.lastAdblockData) {\n1532:         renderTrafficTable(state.lastAdblockData);\n1533:     }\n1534: }\n1535: \n1536: function filterTrafficTable() {\n1537:     const input = document.getElementById('traffic-search');\n1538:     state.adblockSearchQuery = input ? input.value : '';\n1539:     if (state.lastAdblockData) {\n1540:         renderTrafficTable(state.lastAdblockData);\n1541:     }\n1542: }\n1543: \n1544: async function clearWebTrafficLogs() {\n1545:     if (!confirm('Clear all logged web browsing history and analytics?')) return;\n1546:     try {\n1547:         const res = await fetch('/api/adblock/clear-logs', { method: 'POST' });\n1548:         const data = await res.json();\n1549:         if (data.success) {\n1550:             showToast('Logs Cleared', data.message, 'success');\n1551:             loadAdBlockDashboard();\n1552:         }\n1553:     } catch (e) {\n1554:         showToast('Error', 'Unable to clear traffic logs', 'danger');\n1555:     }\n1556: }"}
